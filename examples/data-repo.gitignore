# agent-sync data directory — allowlist style.
# Drop this in the root of your private data directory as `.gitignore`.
# Ignore everything by default, then re-enable what should sync.

*

!.gitignore
!.agent-sync-data
!.agent-sync-projects
!README.md

# Top-level config
!settings.json
!instructions.md
!keybindings.json

# Custom skills
!skills/
!skills/**
skills/**/__pycache__/

# Custom MCP servers (code only — keep .venv device-local)
!mcp-servers/
!mcp-servers/*/
!mcp-servers/**
mcp-servers/*/.venv/

# Project memory
!projects/
!projects/*/
!projects/*/memory/
!projects/*/memory/**

# Ignore conversation logs and other ephemera
projects/*/*.jsonl
