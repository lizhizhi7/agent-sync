#!/usr/bin/env bash
# agent-sync — sync coding-agent config and project memory across devices.
#
# Tool and data are decoupled:
#   • This script is the tool. Install it once per machine.
#   • Your config lives in a private local data directory.
#     Point AGENT_SYNC_DIR at it, then choose a sync backend.
#
# One data directory feeds several agents (Claude Code, tclaude, Codex).
# Each agent declares where its home is and which assets it accepts;
# see the "agent registry" section.
#
# https://github.com/lizhizhi7/agent-sync

set -euo pipefail

KNOWN_AGENTS="claude tclaude codex"
DEFAULT_AGENTS="claude"

REMOTE="${AGENT_SYNC_REMOTE:-origin}"
BACKEND="${AGENT_SYNC_BACKEND:-git}"
STORAGE_URI="${AGENT_SYNC_STORAGE_URI:-}"
STORAGE_OBJECT="${AGENT_SYNC_STORAGE_OBJECT:-agent-sync-data.tar.gz}"
BACKUP_STAMP="$(date '+%Y%m%d-%H%M%S')"
ENV_BLOCK_START="# >>> agent-sync >>>"
ENV_BLOCK_END="# <<< agent-sync <<<"
AGENT_BLOCK_START="<!-- >>> agent-sync:auto-sync >>> -->"
AGENT_BLOCK_END="<!-- <<< agent-sync:auto-sync <<< -->"

# Per-agent context, set by set_agent_context() before any linking work.
AGENT_NAME=""
AGENT_HOME=""
BACKUP_DIR=""

die() {
    echo "ERROR: $*" >&2
    exit 1
}

# ---------- agent registry ----------

# Home directory each agent reads its configuration from.
agent_home() {
    case "$1" in
        claude)  printf '%s\n' "$HOME/.claude" ;;
        tclaude) printf '%s\n' "$HOME/.tclaude" ;;
        codex)   printf '%s\n' "$HOME/.codex" ;;
        *)       die "unknown agent '$1' (known: $KNOWN_AGENTS)" ;;
    esac
}

# Where an asset lives inside the data directory.
asset_source() {
    case "$1" in
        instructions) printf '%s\n' "$REPO_DIR/instructions.md" ;;
        settings)     printf '%s\n' "$REPO_DIR/settings.json" ;;
        keybindings)  printf '%s\n' "$REPO_DIR/keybindings.json" ;;
        skills)       printf '%s\n' "$REPO_DIR/skills" ;;
        mcp-servers)  printf '%s\n' "$REPO_DIR/mcp-servers" ;;
        projects)     printf '%s\n' "$REPO_DIR/projects" ;;
        *)            die "unknown asset '$1'" ;;
    esac
}

# Where an asset lands inside an agent's home, relative to that home.
# Empty output means the agent has no equivalent and the asset is skipped.
#
# Codex is deliberately partial: its settings are TOML (config.toml), it
# registers MCP servers inside that file rather than as a directory, and it
# has no per-project memory store. Only what genuinely maps is mapped.
agent_asset() {
    case "$1:$2" in
        claude:instructions|tclaude:instructions)  printf '%s\n' "CLAUDE.md" ;;
        codex:instructions)                        printf '%s\n' "AGENTS.md" ;;
        claude:settings|tclaude:settings)          printf '%s\n' "settings.json" ;;
        claude:keybindings|tclaude:keybindings)    printf '%s\n' "keybindings.json" ;;
        claude:skills|tclaude:skills|codex:skills) printf '%s\n' "skills" ;;
        claude:mcp-servers|tclaude:mcp-servers)    printf '%s\n' "mcp-servers" ;;
        claude:projects|tclaude:projects)          printf '%s\n' "projects" ;;
        *)                                         printf '%s\n' "" ;;
    esac
}

agent_detected() {
    case "$1" in
        claude)  command_exists claude  || [ -d "$HOME/.claude" ] ;;
        tclaude) command_exists tclaude || [ -d "$HOME/.tclaude" ] ;;
        codex)   command_exists codex   || [ -d "$HOME/.codex" ] ;;
        *)       return 1 ;;
    esac
}

enabled_agents() {
    local item
    for item in $(printf '%s' "$AGENTS_ENABLED" | tr ',' ' '); do
        printf '%s\n' "$item"
    done
}

# Validate up front, in the main shell: enabled_agents() is consumed through
# process substitution, where a die() would only kill the subshell.
validate_agents() {
    local item found=false
    for item in $(printf '%s' "$AGENTS_ENABLED" | tr ',' ' '); do
        agent_home "$item" >/dev/null
        found=true
    done
    [ "$found" = true ] || die "no agents enabled (set AGENT_SYNC_AGENTS or pass -a)"
}

# Enabled agents that accept the given asset.
agents_with_asset() {
    local asset="$1" agent
    while IFS= read -r agent; do
        [ -n "$(agent_asset "$agent" "$asset")" ] && printf '%s\n' "$agent"
    done < <(enabled_agents)
    return 0
}

set_agent_context() {
    AGENT_NAME="$1"
    AGENT_HOME="$(agent_home "$1")"
    BACKUP_DIR="$AGENT_HOME/backups/agent-sync-$BACKUP_STAMP"
}

# ---------- arg parsing ----------

PREFIX=""
WORKDIR=""
WORKDIR_SET=false
AGENTS_ENABLED=""
ARGS=()
UNLINK_ENV=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--prefix)
            [ $# -ge 2 ] || die "$1 requires a value"
            PREFIX="$2"
            shift 2
            ;;
        -w|--workdir)
            [ $# -ge 2 ] || die "$1 requires a value"
            WORKDIR="$2"
            WORKDIR_SET=true
            shift 2
            ;;
        -a|--agents)
            [ $# -ge 2 ] || die "$1 requires a value"
            AGENTS_ENABLED="$2"
            shift 2
            ;;
        -h|--help)    ARGS+=("help"); shift ;;
        --env)        UNLINK_ENV=true; shift ;;
        *)            ARGS+=("$1"); shift ;;
    esac
done
ACTION="${ARGS[0]:-sync}"
ARG1="${ARGS[1]:-}"

[ "$WORKDIR_SET" = false ] && [ -n "${AGENT_SYNC_WORKDIR:-}" ] && WORKDIR="$AGENT_SYNC_WORKDIR"
[ -z "$AGENTS_ENABLED" ] && AGENTS_ENABLED="${AGENT_SYNC_AGENTS:-$DEFAULT_AGENTS}"
[ -z "$PREFIX" ] && PREFIX="$(echo "$HOME" | tr '/' '-')"
[ -n "$WORKDIR" ] && PREFIX="${PREFIX}-$(echo "$WORKDIR" | tr '/' '-')"
[ "$ACTION" = "help" ] || validate_agents

# ---------- data directory resolution ----------

resolve_repo_dir() {
    if [ -z "${AGENT_SYNC_DIR:-}" ]; then
        echo "ERROR: AGENT_SYNC_DIR is not set." >&2
        echo "" >&2
        echo "  Point it at your private data directory:" >&2
        echo "    export AGENT_SYNC_DIR=\"\$HOME/path/to/your/config\"" >&2
        echo "" >&2
        echo "  Or initialize a new one:" >&2
        echo "    agent-sync init ~/path/to/your/config" >&2
        exit 1
    fi
    if [ ! -d "$AGENT_SYNC_DIR" ]; then
        echo "ERROR: AGENT_SYNC_DIR=$AGENT_SYNC_DIR does not exist." >&2
        exit 1
    fi
    local dir home agent
    dir="$(cd "$AGENT_SYNC_DIR" && pwd -P)"
    for agent in $KNOWN_AGENTS; do
        home="$(agent_home "$agent")"
        if [ "$dir" = "$home" ] || [[ "$dir" == "$home"/* ]]; then
            echo "ERROR: AGENT_SYNC_DIR must not be inside $home." >&2
            exit 1
        fi
    done
    if [ ! -e "$dir/.agent-sync-data" ]; then
        echo "ERROR: $dir is not marked as an agent-sync data directory." >&2
        echo "  Run: agent-sync init \"$dir\"" >&2
        echo "  Or, if you know this directory is safe: touch \"$dir/.agent-sync-data\"" >&2
        exit 1
    fi
    printf '%s\n' "$dir"
}

# ---------- helpers ----------

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

is_repo_target() {
    local dest="$1"
    case "$dest" in
        "$REPO_DIR"|"$REPO_DIR"/*) return 0 ;;
        *) return 1 ;;
    esac
}

backup_path() {
    local path="$1" rel dest
    [ -e "$path" ] || [ -L "$path" ] || return 0
    rel="${path#"$AGENT_HOME"/}"
    dest="$BACKUP_DIR/$rel"
    mkdir -p "$(dirname "$dest")"
    mv "$path" "$dest"
    echo "  backed up existing $rel -> $dest"
}

make_link() {
    local target="$1" link_path="$2"
    local link_dir link_name
    link_dir="$(dirname "$link_path")"
    link_name="$(basename "$link_path")"
    mkdir -p "$link_dir"
    if [ -L "$link_path" ]; then
        rm -f "$link_path"
    elif [ -e "$link_path" ]; then
        backup_path "$link_path"
    fi
    ( cd "$link_dir" && ln -s -- "$target" "$link_name" )
}

copy_tree_no_clobber() {
    local src="$1" dst="$2"
    mkdir -p "$dst"
    cp -pRn "$src/." "$dst/" 2>/dev/null || true
}

shell_quote() {
    printf '%q' "$1"
}

remove_managed_block() {
    local file="$1" start="$2" end="$3" tmp
    [ -f "$file" ] || return 0
    tmp="$(mktemp)"
    awk -v start="$start" -v end="$end" '
        $0 == start { skip = 1; next }
        $0 == end { skip = 0; next }
        skip != 1 { print }
    ' "$file" > "$tmp"
    mv "$tmp" "$file"
}

write_managed_block() {
    local file="$1" start="$2" end="$3" body="$4" need_blank=false
    mkdir -p "$(dirname "$file")"
    [ -f "$file" ] || touch "$file"
    remove_managed_block "$file" "$start" "$end"
    [ -s "$file" ] && need_blank=true
    {
        [ "$need_blank" = true ] && printf '\n'
        printf '%s\n' "$start"
        printf '%s\n' "$body"
        printf '%s\n' "$end"
    } >> "$file"
}

managed_block_present() {
    local file="$1" start="$2"
    [ -f "$file" ] && grep -Fqx "$start" "$file"
}

default_shell_profile() {
    case "$(basename "${SHELL:-}")" in
        zsh) printf '%s\n' "$HOME/.zshrc" ;;
        bash) printf '%s\n' "$HOME/.bashrc" ;;
        *) printf '%s\n' "$HOME/.profile" ;;
    esac
}

env_profiles() {
    printf '%s\n' "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile"
}

git_branch() {
    # symbolic-ref works on an unborn branch, before the first commit exists.
    # Fall back to rev-parse so detached HEAD still returns the literal "HEAD"
    # and backend_require() can reject it with a useful error.
    git -C "$REPO_DIR" symbolic-ref --quiet --short HEAD 2>/dev/null \
        || git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null
}

require_remote() {
    if ! git -C "$REPO_DIR" remote get-url "$REMOTE" >/dev/null 2>&1; then
        echo "ERROR: git remote '$REMOTE' not configured in $REPO_DIR." >&2
        echo "  Add one with:" >&2
        echo "    git -C \"$REPO_DIR\" remote add $REMOTE git@github.com:USER/REPO.git" >&2
        exit 1
    fi
}

git_pull_rebase() {
    local branch
    branch="$(git_branch)"
    if ! git -C "$REPO_DIR" ls-remote --exit-code --heads "$REMOTE" "$branch" >/dev/null 2>&1; then
        echo "Remote branch '$branch' not on '$REMOTE' yet; skipping pull."
        return 0
    fi
    if ! git -C "$REPO_DIR" pull --rebase "$REMOTE" "$branch"; then
        echo "" >&2
        echo "ERROR: rebase failed in $REPO_DIR." >&2
        echo "  resolve conflicts then run: git -C \"$REPO_DIR\" rebase --continue" >&2
        echo "  or to abandon:              git -C \"$REPO_DIR\" rebase --abort" >&2
        exit 1
    fi
}

storage_object_uri() {
    [ -n "$STORAGE_URI" ] || die "AGENT_SYNC_STORAGE_URI is required for backend '$BACKEND'."
    printf '%s/%s\n' "${STORAGE_URI%/}" "$STORAGE_OBJECT"
}

synced_data_paths() {
    printf '%s\n' \
        .gitignore \
        .agent-sync-data \
        .agent-sync-projects \
        README.md \
        settings.json \
        instructions.md \
        keybindings.json \
        skills \
        mcp-servers \
        projects
}

create_storage_archive() {
    local archive="$1" stage path
    stage="$(mktemp -d)"
    while IFS= read -r path; do
        [ -e "$REPO_DIR/$path" ] || continue
        cp -pR "$REPO_DIR/$path" "$stage/$path"
    done < <(synced_data_paths)
    if [ -d "$stage/mcp-servers" ]; then
        find "$stage/mcp-servers" -path '*/.venv' -type d -prune -exec rm -rf {} +
    fi
    if [ -d "$stage/projects" ]; then
        find "$stage/projects" -name '*.jsonl' -type f -delete
    fi
    tar -czf "$archive" -C "$stage" .
    rm -rf "$stage"
}

validate_storage_archive() {
    local archive="$1" path line
    while IFS= read -r path; do
        case "$path" in
            /*|../*|*/../*|*/..)
                die "refusing to extract unsafe archive path: $path"
                ;;
        esac
    done < <(tar -tzf "$archive")
    # Reject symlink and hardlink members BEFORE extraction: extracting a
    # symlink and then a member whose path passes through it writes outside
    # the extraction directory.
    while IFS= read -r line; do
        case "$line" in
            l*) die "refusing to extract archive containing symlink: $line" ;;
            h*) die "refusing to extract archive containing hardlink: $line" ;;
        esac
    done < <(tar -tvzf "$archive")
}

extract_storage_archive() {
    local archive="$1" extract_dir="$2" first_link
    mkdir -p "$extract_dir"
    validate_storage_archive "$archive"
    tar -xzf "$archive" -C "$extract_dir"
    first_link="$(find "$extract_dir" -type l -print -quit)"
    [ -z "$first_link" ] || die "refusing to extract archive containing symlink: $first_link"
}

clear_synced_data_paths() {
    local path
    while IFS= read -r path; do
        [ -e "$REPO_DIR/$path" ] || [ -L "$REPO_DIR/$path" ] || continue
        case "$path" in
            .gitignore|.agent-sync-data|README.md) continue ;;
        esac
        rm -rf "${REPO_DIR:?}/$path"
    done < <(synced_data_paths)
}

backend_require() {
    local top branch
    case "$BACKEND" in
        git)
            command_exists git || die "git is required for backend 'git'."
            top="$(git -C "$REPO_DIR" rev-parse --show-toplevel 2>/dev/null)" \
                || die "backend 'git': $REPO_DIR is not a git repository. Run: git -C \"$REPO_DIR\" init"
            [ "$top" = "$REPO_DIR" ] \
                || die "backend 'git': $REPO_DIR is inside another git repository ($top). Initialize it as its own repository first."
            branch="$(git_branch)"
            [ "$branch" != "HEAD" ] \
                || die "backend 'git': $REPO_DIR is on a detached HEAD; check out a branch first."
            require_remote
            ;;
        s3)
            command_exists aws || die "AWS CLI is required for backend 's3'."
            case "$(storage_object_uri)" in
                s3://*) : ;;
                *) die "AGENT_SYNC_STORAGE_URI must start with s3:// for backend 's3'." ;;
            esac
            ;;
        gcs)
            command_exists gcloud || die "gcloud CLI is required for backend 'gcs'."
            case "$(storage_object_uri)" in
                gs://*) : ;;
                *) die "AGENT_SYNC_STORAGE_URI must start with gs:// for backend 'gcs'." ;;
            esac
            ;;
        local)
            ;;
        *)
            die "unknown AGENT_SYNC_BACKEND '$BACKEND' (expected git, s3, gcs, or local)."
            ;;
    esac
}

backend_pull() {
    local uri tmp
    case "$BACKEND" in
        git)
            git_pull_rebase
            ;;
        s3)
            uri="$(storage_object_uri)"
            tmp="$(mktemp -d)"
            if aws s3 ls "$uri" >/dev/null 2>&1; then
                aws s3 cp "$uri" "$tmp/data.tar.gz"
                extract_storage_archive "$tmp/data.tar.gz" "$tmp/extract"
                clear_synced_data_paths
                cp -pR "$tmp/extract/." "$REPO_DIR/"
                echo "Pulled archive from $uri."
            else
                echo "No remote archive found at $uri."
            fi
            rm -rf "$tmp"
            ;;
        gcs)
            uri="$(storage_object_uri)"
            tmp="$(mktemp -d)"
            if gcloud storage ls "$uri" >/dev/null 2>&1; then
                gcloud storage cp "$uri" "$tmp/data.tar.gz"
                extract_storage_archive "$tmp/data.tar.gz" "$tmp/extract"
                clear_synced_data_paths
                cp -pR "$tmp/extract/." "$REPO_DIR/"
                echo "Pulled archive from $uri."
            else
                echo "No remote archive found at $uri."
            fi
            rm -rf "$tmp"
            ;;
        local)
            echo "Local backend: nothing to pull."
            ;;
    esac
}

backend_push() {
    local uri tmp
    case "$BACKEND" in
        git)
            git push "$REMOTE" "$(git_branch)"
            ;;
        s3)
            uri="$(storage_object_uri)"
            tmp="$(mktemp -d)"
            create_storage_archive "$tmp/data.tar.gz"
            aws s3 cp "$tmp/data.tar.gz" "$uri"
            rm -rf "$tmp"
            echo "Pushed archive to $uri."
            ;;
        gcs)
            uri="$(storage_object_uri)"
            tmp="$(mktemp -d)"
            create_storage_archive "$tmp/data.tar.gz"
            gcloud storage cp "$tmp/data.tar.gz" "$uri"
            rm -rf "$tmp"
            echo "Pushed archive to $uri."
            ;;
        local)
            echo "Local backend: nothing to push."
            ;;
    esac
}

git_commit_if_needed() {
    git add -A
    if git diff --cached --quiet; then
        return 1
    fi
    git commit -m "sync: $(hostname 2>/dev/null || uname -n) $(date '+%Y-%m-%d %H:%M')"
}

# ---------- linking ----------

validate_project_name() {
    local name="$1"
    [ -n "$name" ] || die "empty project name"
    case "$name" in
        .|..|*/*|*$'\n'*)
            die "invalid project name '$name'"
            ;;
    esac
}

canonical_for_device_project() {
    local device_name="$1" mapped
    mapped="$(project_mapping_lookup "$device_name")"
    if [ -n "$mapped" ]; then
        printf '%s\n' "$mapped"
    elif [ "$device_name" = "$PREFIX" ]; then
        printf '%s\n' "_home"
    elif [[ "$device_name" == "$PREFIX"-* ]]; then
        printf '%s\n' "${device_name#"$PREFIX"}"
    elif [[ "$device_name" == "$PREFIX"* ]]; then
        printf '%s\n' "${device_name#"$PREFIX"}"
    else
        printf '%s\n' "$device_name"
    fi
}

device_project_name_for_path() {
    local path="$1" root common_dir common_parent
    [ -d "$path" ] || die "project path does not exist or is not a directory: $path"
    path="$(cd "$path" && pwd -P)"
    root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || printf '%s\n' "$path")"

    # A linked git worktree has its own checkout path, but project memory
    # belongs to the repository. Resolve the primary worktree through the
    # common git directory so every worktree reaches the same canonical data.
    common_dir="$(git -C "$root" rev-parse --git-common-dir 2>/dev/null || true)"
    if [ -n "$common_dir" ]; then
        case "$common_dir" in
            /*) : ;;
            *) common_dir="$root/$common_dir" ;;
        esac
        common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P || true)"
        if [ -n "$common_dir" ] && [ "$(basename "$common_dir")" = ".git" ]; then
            common_parent="$(dirname "$common_dir")"
            [ -d "$common_parent" ] && root="$common_parent"
        fi
    fi

    printf '%s\n' "$(printf '%s' "$root" | tr '/' '-')"
}

canonical_for_project_path() {
    local path="$1" device_name
    device_name="$(device_project_name_for_path "$path")"
    canonical_for_device_project "$device_name"
}

project_mapping_lookup() {
    local local_name="$1" map_file line lhs rhs
    map_file="$REPO_DIR/.agent-sync-projects"
    [ -f "$map_file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            ""|\#*) continue ;;
        esac
        lhs="${line%%[[:space:]]*}"
        rhs="${line#"$lhs"}"
        rhs="${rhs#"${rhs%%[![:space:]]*}"}"
        [ "$lhs" = "$local_name" ] || continue
        printf '%s\n' "$rhs"
        return 0
    done < "$map_file"
}

write_project_mapping() {
    local local_name="$1" canonical="$2" map_file tmp line lhs
    validate_project_name "$local_name"
    validate_project_name "$canonical"
    map_file="$REPO_DIR/.agent-sync-projects"
    tmp="$(mktemp)"
    if [ -f "$map_file" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ""|\#*) printf '%s\n' "$line" >> "$tmp"; continue ;;
            esac
            lhs="${line%%[[:space:]]*}"
            [ "$lhs" = "$local_name" ] && continue
            printf '%s\n' "$line" >> "$tmp"
        done < "$map_file"
    fi
    printf '%s %s\n' "$local_name" "$canonical" >> "$tmp"
    mv "$tmp" "$map_file"
}

# Map one device-local project name onto a canonical one, for every enabled
# agent that keeps per-project memory. The mapping file itself is shared:
# Claude Code and tclaude use the identical path-derived naming scheme.
apply_project_mapping() {
    local local_name="$1" canonical="$2" agent local_mem canonical_mem
    validate_project_name "$local_name"
    validate_project_name "$canonical"
    canonical_mem="$REPO_DIR/projects/$canonical/memory"
    mkdir -p "$canonical_mem"
    while IFS= read -r agent; do
        set_agent_context "$agent"
        local_mem="$AGENT_HOME/projects/$local_name/memory"
        if [ -d "$local_mem" ] && [ ! -L "$local_mem" ]; then
            copy_tree_no_clobber "$local_mem" "$canonical_mem"
        fi
        make_link "$canonical_mem" "$local_mem"
        echo "  mapped $local_name -> $canonical ($agent)"
    done < <(agents_with_asset projects)
    write_project_mapping "$local_name" "$canonical"
}

# Link each direct child of src_dir into dest_dir as its own symlink. Entries
# the data directory does not own (vendor-shipped skills, a device-local
# .venv) are left in place; links to entries that have since been removed from
# the data directory are pruned.
link_children() {
    local src_dir="$1" dest_dir="$2" exclude="${3:-}"
    local inner inner_name dest
    # A whole-directory symlink (from an older layout) would shadow the
    # per-entry links; replace it with a real directory.
    if [ -L "$dest_dir" ]; then
        rm -f "$dest_dir"
    fi
    mkdir -p "$dest_dir"
    for inner in "$src_dir"/* "$src_dir"/.[!.]* "$src_dir"/..?*; do
        [ -e "$inner" ] || [ -L "$inner" ] || continue
        inner_name="$(basename "$inner")"
        if [ -n "$exclude" ] && [ "$inner_name" = "$exclude" ]; then
            continue
        fi
        make_link "$inner" "$dest_dir/$inner_name"
    done
    for inner in "$dest_dir"/* "$dest_dir"/.[!.]* "$dest_dir"/..?*; do
        [ -L "$inner" ] || continue
        dest="$(readlink "$inner")"
        if is_repo_target "$dest" && [ ! -e "$inner" ]; then
            rm -f "$inner"
        fi
    done
}

# Remove only the links dest_dir holds into the data directory, then drop the
# directory itself if nothing device-local is left. Prints how many it removed.
unlink_children() {
    local dest_dir="$1" inner dest n=0
    [ -d "$dest_dir" ] || { printf '0\n'; return 0; }
    for inner in "$dest_dir"/* "$dest_dir"/.[!.]* "$dest_dir"/..?*; do
        [ -L "$inner" ] || continue
        dest="$(readlink "$inner")"
        if is_repo_target "$dest"; then
            rm -f "$inner"
            n=$((n + 1))
        fi
    done
    rmdir "$dest_dir" 2>/dev/null || true
    printf '%s\n' "$n"
}

link_agent_configs() {
    local asset rel src
    mkdir -p "$AGENT_HOME"
    for asset in instructions settings keybindings; do
        rel="$(agent_asset "$AGENT_NAME" "$asset")"
        [ -n "$rel" ] || continue
        src="$(asset_source "$asset")"
        [ -f "$src" ] || continue
        make_link "$src" "$AGENT_HOME/$rel"
        echo "  linked $rel"
    done

    rel="$(agent_asset "$AGENT_NAME" skills)"
    src="$(asset_source skills)"
    if [ -n "$rel" ] && [ -d "$src" ]; then
        # Per-skill links, not a directory symlink: agents ship their own
        # skills into this directory (Codex has skills/.system/) and a
        # whole-directory link would hide them.
        link_children "$src" "$AGENT_HOME/$rel"
        echo "  linked skills/"
    fi

    rel="$(agent_asset "$AGENT_NAME" mcp-servers)"
    src="$(asset_source mcp-servers)"
    if [ -n "$rel" ] && [ -d "$src" ]; then
        mkdir -p "$AGENT_HOME/$rel"
        local srv_dir srv_name
        for srv_dir in "$src"/*/; do
            [ ! -d "$srv_dir" ] && continue
            srv_name="$(basename "$srv_dir")"
            # .venv stays device-local so each machine keeps its own venv.
            link_children "${srv_dir%/}" "$AGENT_HOME/$rel/$srv_name" .venv
            echo "  linked mcp-server: $srv_name"
        done
    fi
    return 0
}

link_agent_projects() {
    local rel count=0 canonical_mem canonical device_name map_file line local_name mapped
    rel="$(agent_asset "$AGENT_NAME" projects)"
    [ -n "$rel" ] || return 0
    mkdir -p "$AGENT_HOME/$rel"
    map_file="$REPO_DIR/.agent-sync-projects"
    if [ -f "$map_file" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ""|\#*) continue ;;
            esac
            local_name="${line%%[[:space:]]*}"
            mapped="${line#"$local_name"}"
            mapped="${mapped#"${mapped%%[![:space:]]*}"}"
            [ -n "$mapped" ] || continue
            validate_project_name "$local_name"
            validate_project_name "$mapped"
            mkdir -p "$REPO_DIR/projects/$mapped/memory" "$AGENT_HOME/$rel/$local_name"
            make_link "$REPO_DIR/projects/$mapped/memory" "$AGENT_HOME/$rel/$local_name/memory"
            count=$((count + 1))
        done < "$map_file"
    fi
    for canonical_mem in "$REPO_DIR"/projects/*/memory; do
        [ ! -d "$canonical_mem" ] && continue
        canonical="$(basename "$(dirname "$canonical_mem")")"

        mkdir -p "$AGENT_HOME/$rel/$canonical"
        make_link "$canonical_mem" "$AGENT_HOME/$rel/$canonical/memory"

        if [ "$canonical" = "_home" ]; then
            device_name="$PREFIX"
        else
            device_name="${PREFIX}${canonical}"
        fi
        mkdir -p "$AGENT_HOME/$rel/$device_name"
        make_link "$canonical_mem" "$AGENT_HOME/$rel/$device_name/memory"

        count=$((count + 1))
    done
    [ "$count" -gt 0 ] && echo "  linked memory for $count project(s)"
    return 0
}

migrate_agent_memory() {
    local rel count=0 device_mem device_dir canonical
    rel="$(agent_asset "$AGENT_NAME" projects)"
    [ -n "$rel" ] || return 0
    [ ! -d "$AGENT_HOME/$rel" ] && return 0
    for device_mem in "$AGENT_HOME/$rel/${PREFIX}"-*/memory; do
        [ ! -d "$device_mem" ] && continue
        [ -L "$device_mem" ] && continue
        device_dir="$(basename "$(dirname "$device_mem")")"
        canonical="$(canonical_for_device_project "$device_dir")"
        mkdir -p "$REPO_DIR/projects/$canonical/memory"
        copy_tree_no_clobber "$device_mem" "$REPO_DIR/projects/$canonical/memory"
        count=$((count + 1))
    done
    if [ -d "$AGENT_HOME/$rel/$PREFIX/memory" ] \
       && [ ! -L "$AGENT_HOME/$rel/$PREFIX/memory" ]; then
        mkdir -p "$REPO_DIR/projects/_home/memory"
        copy_tree_no_clobber "$AGENT_HOME/$rel/$PREFIX/memory" "$REPO_DIR/projects/_home/memory"
        count=$((count + 1))
    fi
    [ "$count" -gt 0 ] && echo "  migrated memory from $count local project(s) ($AGENT_NAME)"
    return 0
}

migrate_local_memory() {
    local agent
    while IFS= read -r agent; do
        set_agent_context "$agent"
        migrate_agent_memory
    done < <(agents_with_asset projects)
    return 0
}

clean_agent_projects() {
    local rel count=0 mem_link proj_dir
    rel="$(agent_asset "$AGENT_NAME" projects)"
    [ -n "$rel" ] || return 0
    [ ! -d "$AGENT_HOME/$rel" ] && return 0
    for mem_link in "$AGENT_HOME/$rel"/*/memory; do
        [ ! -L "$mem_link" ] && continue
        if [ ! -e "$mem_link" ]; then
            proj_dir="$(dirname "$mem_link")"
            rm -f "$mem_link"
            rmdir "$proj_dir" 2>/dev/null || true
            count=$((count + 1))
        fi
    done
    [ "$count" -gt 0 ] && echo "  cleaned $count broken symlink(s) ($AGENT_NAME)"
    return 0
}

clean_projects() {
    local agent
    while IFS= read -r agent; do
        set_agent_context "$agent"
        clean_agent_projects
    done < <(agents_with_asset projects)
    return 0
}

do_link() {
    local agent
    echo "Linking $REPO_DIR (prefix: $PREFIX) ..."
    migrate_local_memory
    while IFS= read -r agent; do
        set_agent_context "$agent"
        echo "$agent -> $AGENT_HOME"
        clean_agent_projects
        link_agent_configs
        link_agent_projects
    done < <(enabled_agents)
    echo "Done."
}

UNLINK_COUNT=0
unlink_agent() {
    local removed=0 n dest asset rel target srv_dir srv_name mem_link

    for asset in instructions settings keybindings; do
        rel="$(agent_asset "$AGENT_NAME" "$asset")"
        [ -n "$rel" ] || continue
        target="$AGENT_HOME/$rel"
        if [ -L "$target" ]; then
            dest="$(readlink "$target")"
            if is_repo_target "$dest"; then
                rm -f "$target"
                echo "  unlinked $rel"
                removed=$((removed+1))
            fi
        fi
    done

    rel="$(agent_asset "$AGENT_NAME" skills)"
    if [ -n "$rel" ]; then
        n="$(unlink_children "$AGENT_HOME/$rel")"
        if [ "$n" -gt 0 ]; then
            echo "  unlinked $n skill(s)"
            removed=$((removed + n))
        fi
    fi

    rel="$(agent_asset "$AGENT_NAME" mcp-servers)"
    if [ -n "$rel" ] && [ -d "$AGENT_HOME/$rel" ]; then
        for srv_dir in "$AGENT_HOME/$rel"/*/; do
            [ ! -d "$srv_dir" ] && continue
            srv_name="$(basename "$srv_dir")"
            n="$(unlink_children "${srv_dir%/}")"
            if [ "$n" -gt 0 ]; then
                echo "  unlinked mcp-server: $srv_name"
                removed=$((removed + 1))
            fi
        done
        rmdir "$AGENT_HOME/$rel" 2>/dev/null || true
    fi

    rel="$(agent_asset "$AGENT_NAME" projects)"
    if [ -n "$rel" ] && [ -d "$AGENT_HOME/$rel" ]; then
        for mem_link in "$AGENT_HOME/$rel"/*/memory; do
            [ ! -L "$mem_link" ] && continue
            dest="$(readlink "$mem_link")"
            if is_repo_target "$dest"; then
                rm -f "$mem_link"
                rmdir "$(dirname "$mem_link")" 2>/dev/null || true
                removed=$((removed+1))
            fi
        done
    fi

    UNLINK_COUNT=$((UNLINK_COUNT + removed))
}

do_unlink() {
    local agent
    echo "Unlinking agent-sync ..."
    UNLINK_COUNT=0
    while IFS= read -r agent; do
        set_agent_context "$agent"
        echo "$agent -> $AGENT_HOME"
        unlink_agent
    done < <(enabled_agents)
    if [ "$UNLINK_COUNT" -eq 0 ]; then
        echo "  nothing to unlink."
    else
        echo "Unlinked $UNLINK_COUNT item(s). Data directory at $REPO_DIR is intact."
    fi
    if [ "$UNLINK_ENV" = true ]; then
        do_env remove
    fi
}

env_block_body() {
    local body
    body="export AGENT_SYNC_DIR=$(shell_quote "$REPO_DIR")"
    body="${body}"$'\n'"export AGENT_SYNC_BACKEND=$(shell_quote "$BACKEND")"
    [ "$AGENTS_ENABLED" != "$DEFAULT_AGENTS" ] \
        && body="${body}"$'\n'"export AGENT_SYNC_AGENTS=$(shell_quote "$AGENTS_ENABLED")"
    [ -n "$STORAGE_URI" ] && body="${body}"$'\n'"export AGENT_SYNC_STORAGE_URI=$(shell_quote "$STORAGE_URI")"
    [ -n "$STORAGE_OBJECT" ] && [ "$STORAGE_OBJECT" != "agent-sync-data.tar.gz" ] \
        && body="${body}"$'\n'"export AGENT_SYNC_STORAGE_OBJECT=$(shell_quote "$STORAGE_OBJECT")"
    [ -n "$WORKDIR" ] && body="${body}"$'\n'"export AGENT_SYNC_WORKDIR=$(shell_quote "$WORKDIR")"
    [ -n "$REMOTE" ] && [ "$REMOTE" != "origin" ] && body="${body}"$'\n'"export AGENT_SYNC_REMOTE=$(shell_quote "$REMOTE")"
    printf '%s\n' "$body"
}

do_env() {
    local sub="${1:-status}" profile found=false
    case "$sub" in
        install)
            profile="$(default_shell_profile)"
            write_managed_block "$profile" "$ENV_BLOCK_START" "$ENV_BLOCK_END" "$(env_block_body)"
            echo "Installed agent-sync env block in $profile"
            ;;
        remove|clean)
            while IFS= read -r profile; do
                if managed_block_present "$profile" "$ENV_BLOCK_START"; then
                    remove_managed_block "$profile" "$ENV_BLOCK_START" "$ENV_BLOCK_END"
                    echo "Removed agent-sync env block from $profile"
                    found=true
                fi
            done < <(env_profiles)
            [ "$found" = true ] || echo "No managed agent-sync env blocks found."
            ;;
        status)
            while IFS= read -r profile; do
                if managed_block_present "$profile" "$ENV_BLOCK_START"; then
                    echo "managed env block: $profile"
                    found=true
                fi
            done < <(env_profiles)
            [ "$found" = true ] || echo "No managed agent-sync env blocks found."
            ;;
        print)
            printf '%s\n' "$ENV_BLOCK_START"
            env_block_body
            printf '%s\n' "$ENV_BLOCK_END"
            ;;
        *)
            die "unknown env command '$sub' (expected install, remove, status, or print)"
            ;;
    esac
}

# ---------- managed agent instructions ----------

# The instruction block lives in the shared instructions file, which is
# symlinked into every enabled agent's home — one copy reaches all of them.
agent_instruction_body() {
    cat <<'EOF'
Use agent-sync for durable agent configuration and memory changes on this machine:

- Run `agent-sync status` before changing synced config or project memory when context is unclear.
- Agents without native access to synced project memory (including Codex) must run `agent-sync memory` at the start of repository work, use its `MEMORY.md` output as the index, and read relevant detail files before acting.
- Run `agent-sync match` if a project appears under a new local project name.
- Run `agent-sync sync` after changes that should be shared across devices.
- Do not edit shell profiles, unlink synced files, or delete local agent data unless the user asks.
EOF
}

do_instructions() {
    local sub="${1:-status}" target
    target="$(asset_source instructions)"
    case "$sub" in
        install)
            write_managed_block "$target" "$AGENT_BLOCK_START" "$AGENT_BLOCK_END" "$(agent_instruction_body)"
            echo "Installed agent-sync instruction block in $target"
            ;;
        remove|clean)
            if managed_block_present "$target" "$AGENT_BLOCK_START"; then
                remove_managed_block "$target" "$AGENT_BLOCK_START" "$AGENT_BLOCK_END"
                echo "Removed agent-sync instruction block from $target"
            else
                echo "No managed agent-sync instruction block found in $target"
            fi
            ;;
        status)
            if managed_block_present "$target" "$AGENT_BLOCK_START"; then
                echo "managed instruction block: $target"
            else
                echo "no managed instruction block in $target"
            fi
            ;;
        *)
            die "unknown instructions command '$sub' (expected install, remove, or status)"
            ;;
    esac
}

do_agents() {
    local agent state assets asset rel enabled
    echo "Data: $REPO_DIR"
    echo ""
    printf '  %-9s %-9s %-24s %s\n' "AGENT" "STATE" "HOME" "SYNCED ASSETS"
    for agent in $KNOWN_AGENTS; do
        enabled=false
        if printf '%s\n' "$AGENTS_ENABLED" | tr ',' '\n' | grep -Fqx "$agent"; then
            enabled=true
        fi
        if [ "$enabled" = true ]; then
            state="enabled"
        elif agent_detected "$agent"; then
            state="detected"
        else
            state="absent"
        fi
        assets=""
        for asset in instructions settings keybindings skills mcp-servers projects; do
            rel="$(agent_asset "$agent" "$asset")"
            [ -n "$rel" ] && assets="$assets $asset"
        done
        printf '  %-9s %-9s %-24s %s\n' \
            "$agent" "$state" "$(agent_home "$agent" | sed "s|^$HOME|~|")" "${assets# }"
    done
    echo ""
    echo "Enable agents with AGENT_SYNC_AGENTS=\"claude,codex\" (or -a claude,codex),"
    echo "then run \`agent-sync link\`."
}

# ---------- project matching ----------

project_link_state() {
    local mem="$1" dest
    if [ -L "$mem" ]; then
        if [ ! -e "$mem" ]; then
            printf '%s\n' "broken"
        else
            dest="$(readlink "$mem")"
            if is_repo_target "$dest"; then
                printf '%s\n' "linked"
            else
                printf '%s\n' "foreign"
            fi
        fi
    elif [ -d "$mem" ]; then
        printf '%s\n' "local"
    else
        printf '%s\n' "missing"
    fi
}

print_project_match_row() {
    local local_name="$1" state="$2" canonical="$3"
    printf '  %-10s %-48s -> %s\n' "$state" "$local_name" "$canonical"
}

do_match() {
    local dry_run=false auto=false explicit=false arg local_name canonical
    local agent projects_dir rel
    local mem device_dir state suggestion applied=0 seen=0
    local i=1

    while [ "$i" -lt "${#ARGS[@]}" ]; do
        arg="${ARGS[$i]}"
        case "$arg" in
            --auto)
                auto=true
                ;;
            --dry-run)
                dry_run=true
                ;;
            *:*)
                local_name="${arg%%:*}"
                canonical="${arg#*:}"
                apply_project_mapping "$local_name" "$canonical"
                explicit=true
                applied=$((applied + 1))
                ;;
            *)
                die "unknown match argument '$arg'"
                ;;
        esac
        i=$((i + 1))
    done

    if [ "$explicit" = true ]; then
        echo "Applied $applied explicit mapping(s)."
        return 0
    fi
    if [ "$auto" = false ] && [ "$dry_run" = false ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
        dry_run=true
    fi

    echo "Project match scan"
    echo "Data:   $REPO_DIR"
    echo "Prefix: $PREFIX"
    echo ""

    while IFS= read -r agent; do
        set_agent_context "$agent"
        rel="$(agent_asset "$agent" projects)"
        projects_dir="$AGENT_HOME/$rel"
        [ -d "$projects_dir" ] || continue
        echo "$agent ($projects_dir):"

        for mem in "$projects_dir"/*/memory; do
            [ -e "$mem" ] || [ -L "$mem" ] || continue
            device_dir="$(basename "$(dirname "$mem")")"
            state="$(project_link_state "$mem")"
            suggestion="$(canonical_for_device_project "$device_dir")"
            seen=$((seen + 1))

            case "$state" in
                local)
                    print_project_match_row "$device_dir" "$state" "$suggestion"
                    if [ "$dry_run" = true ]; then
                        :
                    elif [ "$auto" = true ]; then
                        apply_project_mapping "$device_dir" "$suggestion"
                        applied=$((applied + 1))
                    elif [ -t 0 ] && [ -t 1 ]; then
                        if prompt_yn "Map $device_dir to $suggestion?"; then
                            apply_project_mapping "$device_dir" "$suggestion"
                            applied=$((applied + 1))
                        fi
                    fi
                    ;;
                *)
                    print_project_match_row "$device_dir" "$state" "$suggestion"
                    ;;
            esac
        done
        echo ""
    done < <(agents_with_asset projects)

    if [ "$seen" -eq 0 ]; then
        echo "No local project memory directories found."
    elif [ "$dry_run" = true ]; then
        echo "Preview only. Use 'agent-sync match --auto' to apply suggestions,"
        echo "or 'agent-sync match LOCAL:CANONICAL' for an explicit mapping."
    elif [ "$applied" -gt 0 ]; then
        echo "Applied $applied project mapping(s)."
    fi
}

# Print the curated cross-agent memory index for a repository. Claude-family
# agents consume the same directory through their native project-memory path;
# agents without that path (notably Codex) use this command from their global
# instructions instead of writing into framework-generated memory stores.
do_memory() {
    local project_path="${1:-$PWD}" canonical memory_dir index file found=false
    canonical="$(canonical_for_project_path "$project_path")"
    memory_dir="$REPO_DIR/projects/$canonical/memory"
    index="$memory_dir/MEMORY.md"

    if [ ! -d "$memory_dir" ]; then
        echo "No synced project memory for $project_path (canonical: $canonical)." >&2
        echo "Run 'agent-sync match' if this repository is stored under another name." >&2
        return 1
    fi

    echo "Project memory: $memory_dir"
    echo "Canonical project: $canonical"
    echo ""
    if [ -f "$index" ]; then
        cat "$index"
        found=true
    else
        echo "No MEMORY.md index. Available memory files:"
    fi

    for file in "$memory_dir"/*; do
        [ -f "$file" ] || continue
        [ "$file" = "$index" ] && continue
        if [ "$found" = true ]; then
            echo ""
            echo "Detail file: $file"
        else
            echo "  $file"
        fi
    done
}

# ---------- init ----------

prompt_yn() {
    local q="$1" def="${2:-y}" hint reply
    [ "$def" = "y" ] && hint="[Y/n]" || hint="[y/N]"
    while :; do
        read -r -p "$q $hint " reply </dev/tty || return 1
        reply="${reply:-$def}"
        case "$reply" in
            [Yy]|[Yy][Ee][Ss]) return 0 ;;
            [Nn]|[Nn][Oo])     return 1 ;;
        esac
    done
}

prompt_path() {
    local q="$1" def="$2" reply
    if [ -n "$def" ]; then
        read -r -p "$q [$def]: " reply </dev/tty || return 1
        reply="${reply:-$def}"
    else
        read -r -p "$q: " reply </dev/tty || return 1
    fi
    # shellcheck disable=SC2088  # matching a literal leading tilde in user input
    case "$reply" in
        "~"|"~/"*) reply="$HOME${reply#\~}" ;;
    esac
    printf '%s' "$reply"
}

# Import scans every enabled agent; the first agent that provides a given
# asset wins, so list your primary agent first in AGENT_SYNC_AGENTS.
has_existing_agent_content() {
    local agent asset rel d
    while IFS= read -r agent; do
        set_agent_context "$agent"
        [ -d "$AGENT_HOME" ] || continue
        for asset in instructions settings keybindings; do
            rel="$(agent_asset "$agent" "$asset")"
            [ -n "$rel" ] || continue
            [ -f "$AGENT_HOME/$rel" ] && [ ! -L "$AGENT_HOME/$rel" ] && return 0
        done
        for asset in skills mcp-servers; do
            rel="$(agent_asset "$agent" "$asset")"
            [ -n "$rel" ] || continue
            if [ -d "$AGENT_HOME/$rel" ] && [ ! -L "$AGENT_HOME/$rel" ]; then
                [ -n "$(ls -A "$AGENT_HOME/$rel" 2>/dev/null)" ] && return 0
            fi
        done
        rel="$(agent_asset "$agent" projects)"
        if [ -n "$rel" ] && [ -d "$AGENT_HOME/$rel" ]; then
            for d in "$AGENT_HOME/$rel"/*/; do
                [ -d "$d/memory" ] && [ ! -L "$d/memory" ] && return 0
            done
        fi
    done < <(enabled_agents)
    return 1
}

summarize_agent_content() {
    local agent asset rel n d
    while IFS= read -r agent; do
        set_agent_context "$agent"
        [ -d "$AGENT_HOME" ] || continue
        echo "  [$agent] $AGENT_HOME"
        for asset in instructions settings keybindings; do
            rel="$(agent_asset "$agent" "$asset")"
            [ -n "$rel" ] || continue
            if [ -f "$AGENT_HOME/$rel" ] && [ ! -L "$AGENT_HOME/$rel" ]; then
                echo "    $rel ($(du -h "$AGENT_HOME/$rel" 2>/dev/null | awk '{print $1}'))"
            fi
        done
        for asset in skills mcp-servers; do
            rel="$(agent_asset "$agent" "$asset")"
            [ -n "$rel" ] || continue
            if [ -d "$AGENT_HOME/$rel" ] && [ ! -L "$AGENT_HOME/$rel" ]; then
                n=$(find "$AGENT_HOME/$rel" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
                [ "$n" -gt 0 ] && echo "    $rel/ ($n entr(ies))"
            fi
        done
        rel="$(agent_asset "$agent" projects)"
        if [ -n "$rel" ] && [ -d "$AGENT_HOME/$rel" ]; then
            n=0
            for d in "$AGENT_HOME/$rel"/*/; do
                [ -d "$d/memory" ] && [ ! -L "$d/memory" ] && n=$((n+1))
            done
            [ "$n" -gt 0 ] && echo "    $rel/ ($n project(s) with memory)"
        fi
    done < <(enabled_agents)
    return 0
}

import_existing_top_level() {
    local target="$1"
    local agent asset rel src dest srv_dir srv_name any
    while IFS= read -r agent; do
        set_agent_context "$agent"
        [ -d "$AGENT_HOME" ] || continue

        for asset in instructions settings keybindings; do
            rel="$(agent_asset "$agent" "$asset")"
            [ -n "$rel" ] || continue
            src="$AGENT_HOME/$rel"
            dest="$target/$(basename "$(asset_source "$asset")")"
            [ -f "$src" ] && [ ! -L "$src" ] && [ ! -e "$dest" ] || continue
            cp -p "$src" "$dest"
            echo "  imported $(basename "$dest") (from $agent)"
        done

        rel="$(agent_asset "$agent" skills)"
        if [ -n "$rel" ] && [ -d "$AGENT_HOME/$rel" ] && [ ! -L "$AGENT_HOME/$rel" ] \
           && [ -n "$(ls -A "$AGENT_HOME/$rel" 2>/dev/null)" ]; then
            mkdir -p "$target/skills"
            cp -Rn "$AGENT_HOME/$rel/." "$target/skills/" 2>/dev/null || true
            echo "  imported skills/ (from $agent)"
        fi

        rel="$(agent_asset "$agent" mcp-servers)"
        if [ -n "$rel" ] && [ -d "$AGENT_HOME/$rel" ] && [ ! -L "$AGENT_HOME/$rel" ]; then
            any=false
            for srv_dir in "$AGENT_HOME/$rel"/*/; do
                [ ! -d "$srv_dir" ] && continue
                srv_name="$(basename "$srv_dir")"
                [ -e "$target/mcp-servers/$srv_name" ] && continue
                mkdir -p "$target/mcp-servers/$srv_name"
                cp -R "$srv_dir/." "$target/mcp-servers/$srv_name/"
                rm -rf "$target/mcp-servers/$srv_name/.venv"
                any=true
            done
            [ "$any" = true ] && echo "  imported mcp-servers/ (from $agent)"
        fi
    done < <(enabled_agents)
    return 0
}

write_data_repo_scaffold() {
    local target="$1"
    if [ "$BACKEND" = "git" ] && [ ! -d "$target/.git" ]; then
        git -C "$target" init -q -b main 2>/dev/null || git -C "$target" init -q
    fi
    cat > "$target/.gitignore" <<'EOF'
# agent-sync data directory — allowlist style.
# Ignore everything by default, then re-enable what should sync.
*

!.gitignore
!.agent-sync-data
!.agent-sync-projects
!README.md

# Top-level config
!settings.json
!instructions.md
!keybindings.json

# Custom skills
!skills/
!skills/**

# Custom MCP servers (code only — keep .venv device-local)
!mcp-servers/
!mcp-servers/*/
!mcp-servers/**
mcp-servers/*/.venv/

# Project memory
!projects/
!projects/*/
!projects/*/memory/
!projects/*/memory/**

# Ignore conversation logs and other ephemera
projects/*/*.jsonl
EOF
    touch "$target/.agent-sync-data"
}

print_init_next_steps() {
    local target="$1" include_remote="${2:-true}"
    echo ""
    echo "Next steps:"
    echo "  1. Install the managed shell env block:"
    printf '       '
    [ "$BACKEND" != "git" ] && printf 'AGENT_SYNC_BACKEND="%s" ' "$BACKEND"
    [ -n "$STORAGE_URI" ] && printf 'AGENT_SYNC_STORAGE_URI="%s" ' "$STORAGE_URI"
    [ -n "$WORKDIR" ] && printf 'AGENT_SYNC_WORKDIR="%s" ' "$WORKDIR"
    [ "$AGENTS_ENABLED" != "$DEFAULT_AGENTS" ] && printf 'AGENT_SYNC_AGENTS="%s" ' "$AGENTS_ENABLED"
    printf 'AGENT_SYNC_DIR="%s" agent-sync env install\n' "$target"
    echo "     Or add manually to your shell profile:"
    echo "       export AGENT_SYNC_DIR=\"$target\""
    [ "$BACKEND" != "git" ] && echo "       export AGENT_SYNC_BACKEND=\"$BACKEND\""
    [ -n "$STORAGE_URI" ] && echo "       export AGENT_SYNC_STORAGE_URI=\"$STORAGE_URI\""
    [ -n "$WORKDIR" ] && echo "       export AGENT_SYNC_WORKDIR=\"$WORKDIR\""
    [ "$AGENTS_ENABLED" != "$DEFAULT_AGENTS" ] && echo "       export AGENT_SYNC_AGENTS=\"$AGENTS_ENABLED\""
    if [ "$BACKEND" = "git" ] && [ "$include_remote" = true ]; then
        echo "  2. Add a private remote (recommended):"
        echo "       git -C \"$target\" remote add origin git@github.com:USER/REPO.git"
        echo "  3. Set up symlinks:"
        echo "       AGENT_SYNC_DIR=\"$target\" agent-sync link"
    else
        echo "  2. Set up symlinks:"
        echo "       AGENT_SYNC_DIR=\"$target\" agent-sync link"
    fi
}

do_init_create() {
    # $1 = target, $2 = "import" (true|false)
    local target="$1" import="$2"
    if [ -e "$target" ] && [ -n "$(ls -A "$target" 2>/dev/null)" ]; then
        echo "ERROR: $target is not empty." >&2
        exit 1
    fi
    mkdir -p "$target"
    target="$(cd "$target" && pwd)"
    write_data_repo_scaffold "$target"

    if [ "$import" = true ]; then
        echo ""
        echo "Importing from enabled agents ($AGENTS_ENABLED) ..."
        REPO_DIR="$target"
        import_existing_top_level "$target"
        migrate_local_memory
        echo "Created $target with existing config imported."
    else
        echo "Initialized empty agent-sync data directory at $target"
    fi
    print_init_next_steps "$target" true
}

do_init() {
    local target="$ARG1"

    # Non-interactive: explicit target arg → empty repo, no import
    if [ -n "$target" ]; then
        do_init_create "$target" false
        return 0
    fi

    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "Usage: agent-sync init <directory>" >&2
        echo "  (or run in a TTY for interactive mode)" >&2
        exit 1
    fi

    # Interactive wizard
    local import=false use_existing=false

    if has_existing_agent_content; then
        echo "Found existing agent data for: $AGENTS_ENABLED"
        summarize_agent_content
        echo
        if prompt_yn "Make this a syncable data directory (all files including project memory)?"; then
            import=true
        fi
        echo
    fi

    if [ "$import" = false ]; then
        if prompt_yn "Do you already have an agent-sync data directory on disk?" n; then
            use_existing=true
        fi
        echo
    fi

    if [ "$use_existing" = true ]; then
        target="$(prompt_path "Data directory path" "")"
        if [ -z "$target" ] || [ ! -d "$target" ]; then
            echo "ERROR: $target does not exist." >&2
            exit 1
        fi
        target="$(cd "$target" && pwd)"
        echo "Using existing data directory at $target."
        print_init_next_steps "$target" false
        return 0
    fi

    target="$(prompt_path "Data directory path" "$HOME/.agent-config-data")"
    do_init_create "$target" "$import"
}

# ---------- vendored skills ----------

# A skill copied from another team's repository or package records where it
# came from in skills/<name>/.upstream (key=value lines: source, path, ref,
# updated). Its directory holds upstream's files plus whatever we changed.
# `skill diff` shows those changes against the pinned upstream; `skill update`
# moves to a new upstream ref with a three-way merge per file (base = pinned
# upstream, ours = the directory, theirs = the new upstream), so our changes
# survive and a clash becomes conflict markers instead of silent drift. Files
# upstream never had (our sidecars and notes) are never touched.

SKILL_UPSTREAM_FILE=".upstream"

upstream_value() {
    sed -n "s/^$2=//p" "$1" | head -n 1
}

skill_dir_for() {
    case "$1" in
        ""|.*|*/*) die "invalid skill name '$1'" ;;
    esac
    printf '%s\n' "$REPO_DIR/skills/$1"
}

# fetch_skill_source SOURCE PATH REF DEST
# Copy the skill at PATH inside SOURCE (a git URL, or npm:<package>) at REF
# (empty = latest) into DEST, and print the exact ref it resolved to: a commit
# for git, a version for npm.
fetch_skill_source() {
    local source="$1" path="$2" ref="$3" dest="$4" work root resolved tarball spec
    work="$(mktemp -d)"
    case "$source" in
        npm:*)
            command_exists npm || { rm -rf "$work"; die "npm is required for $source"; }
            spec="${source#npm:}"
            [ -n "$ref" ] && spec="$spec@$ref"
            if ! ( cd "$work" && npm pack --silent "$spec" >/dev/null ); then
                rm -rf "$work"
                die "npm pack $spec failed"
            fi
            tarball="$(find "$work" -maxdepth 1 -name '*.tgz' | head -n 1)"
            validate_storage_archive "$tarball"
            mkdir "$work/x"
            tar -xzf "$tarball" -C "$work/x"
            root="$work/x/package"
            resolved="$(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$root/package.json" | head -n 1)"
            ;;
        *)
            command_exists git || { rm -rf "$work"; die "git is required for $source"; }
            root="$work/repo"
            git init -q "$root"
            if git -C "$root" fetch -q --depth 1 "$source" "${ref:-HEAD}" 2>/dev/null; then
                git -C "$root" checkout -q FETCH_HEAD
            else
                # Some servers refuse a bare commit in a shallow fetch: take it all.
                rm -rf "$root"
                if ! git clone -q "$source" "$root" \
                    || { [ -n "$ref" ] && ! git -C "$root" checkout -q "$ref"; }; then
                    rm -rf "$work"
                    die "could not fetch ${ref:-HEAD} of $source"
                fi
            fi
            resolved="$(git -C "$root" rev-parse HEAD)"
            ;;
    esac
    if [ ! -f "$root/$path/SKILL.md" ]; then
        rm -rf "$work"
        die "no SKILL.md at '$path' in $source"
    fi
    if [ -n "$(find "$root/$path" -type l -not -path '*/.git/*' | head -n 1)" ]; then
        rm -rf "$work"
        die "refusing to vendor a skill containing symlinks ($source $path)"
    fi
    mkdir -p "$dest"
    ( cd "$root/$path" && tar -cf - --exclude=.git . ) | ( cd "$dest" && tar -xf - )
    rm -rf "$work"
    printf '%s\n' "$resolved"
}

write_upstream() {
    {
        echo "# Where this skill comes from. Managed by agent-sync skill add/update."
        echo "source=$2"
        echo "path=$3"
        echo "ref=$4"
        echo "updated=$(date '+%Y-%m-%d')"
    } > "$1/$SKILL_UPSTREAM_FILE"
}

skill_list() {
    local up found=false
    for up in "$REPO_DIR"/skills/*/"$SKILL_UPSTREAM_FILE"; do
        [ -f "$up" ] || continue
        found=true
        printf '%-24s %s %s @ %s (%s)\n' "$(basename "$(dirname "$up")")" \
            "$(upstream_value "$up" source)" "$(upstream_value "$up" path)" \
            "$(upstream_value "$up" ref)" "$(upstream_value "$up" updated)"
    done
    [ "$found" = true ] || echo "No vendored skills (no skills/*/$SKILL_UPSTREAM_FILE)."
}

skill_add() {
    local name="$1" source="$2" path="${3:-.}" ref="${4:-}" dir tmp resolved
    dir="$(skill_dir_for "$name")"
    [ -e "$dir" ] && die "skills/$name already exists (to move it: agent-sync skill update $name)"
    tmp="$(mktemp -d)"
    resolved="$(fetch_skill_source "$source" "$path" "$ref" "$tmp/new")" || { rm -rf "$tmp"; exit 1; }
    mkdir -p "$REPO_DIR/skills"
    mv "$tmp/new" "$dir"
    rm -rf "$tmp"
    write_upstream "$dir" "$source" "$path" "$resolved"
    echo "Vendored $source ($path @ $resolved) into skills/$name"
}

skill_origin() {
    local dir="$1" up
    up="$dir/$SKILL_UPSTREAM_FILE"
    [ -f "$up" ] || die "$(basename "$dir") is not vendored (no $SKILL_UPSTREAM_FILE)"
    SKILL_SOURCE="$(upstream_value "$up" source)"
    SKILL_PATH="$(upstream_value "$up" path)"
    SKILL_REF="$(upstream_value "$up" ref)"
    [ -n "$SKILL_SOURCE" ] && [ -n "$SKILL_REF" ] || die "$up lacks source or ref"
}

skill_diff() {
    local dir tmp
    dir="$(skill_dir_for "$1")"
    skill_origin "$dir"
    tmp="$(mktemp -d)"
    fetch_skill_source "$SKILL_SOURCE" "${SKILL_PATH:-.}" "$SKILL_REF" "$tmp/upstream" >/dev/null \
        || { rm -rf "$tmp"; exit 1; }
    ( cd "$tmp" && diff -ruN -x "$SKILL_UPSTREAM_FILE" -x __pycache__ -x .DS_Store \
        upstream "$dir" ) || true
    rm -rf "$tmp"
}

skill_update() {
    local name="$1" want="${2:-}" dir tmp new rel b o t conflicts=0 empty
    dir="$(skill_dir_for "$name")"
    skill_origin "$dir"
    tmp="$(mktemp -d)"
    fetch_skill_source "$SKILL_SOURCE" "${SKILL_PATH:-.}" "$SKILL_REF" "$tmp/base" >/dev/null \
        || { rm -rf "$tmp"; exit 1; }
    new="$(fetch_skill_source "$SKILL_SOURCE" "${SKILL_PATH:-.}" "$want" "$tmp/new")" \
        || { rm -rf "$tmp"; exit 1; }
    if [ "$new" = "$SKILL_REF" ]; then
        rm -rf "$tmp"
        echo "skills/$name is already at $new"
        return 0
    fi
    empty="$tmp/empty"
    : > "$empty"
    while IFS= read -r rel; do
        rel="${rel#./}"
        b="$tmp/base/$rel"
        o="$dir/$rel"
        t="$tmp/new/$rel"
        if [ ! -e "$o" ]; then
            if [ ! -e "$b" ]; then
                mkdir -p "$(dirname "$o")"
                cp -p "$t" "$o"
            elif ! cmp -s "$b" "$t"; then
                echo "CONFLICT $rel: removed here, changed upstream"
                conflicts=$((conflicts + 1))
            fi
        elif [ ! -e "$b" ]; then
            if ! cmp -s "$o" "$t" && ! git merge-file -L ours -L base -L upstream "$o" "$empty" "$t"; then
                echo "CONFLICT $rel: added on both sides"
                conflicts=$((conflicts + 1))
            fi
        elif cmp -s "$o" "$b"; then
            cp -p "$t" "$o"
        elif ! cmp -s "$b" "$t"; then
            if ! git merge-file -L ours -L "upstream $SKILL_REF" -L "upstream $new" "$o" "$b" "$t"; then
                echo "CONFLICT $rel: changed here and upstream"
                conflicts=$((conflicts + 1))
            fi
        fi
    done < <(cd "$tmp/new" && find . -type f | sort)
    while IFS= read -r rel; do
        rel="${rel#./}"
        [ -e "$tmp/new/$rel" ] && continue
        o="$dir/$rel"
        [ -e "$o" ] || continue
        if cmp -s "$o" "$tmp/base/$rel"; then
            rm -f "$o"
        else
            echo "CONFLICT $rel: changed here, removed upstream"
            conflicts=$((conflicts + 1))
        fi
    done < <(cd "$tmp/base" && find . -type f | sort)
    rm -rf "$tmp"
    write_upstream "$dir" "$SKILL_SOURCE" "${SKILL_PATH:-.}" "$new"
    echo "skills/$name: $SKILL_REF -> $new"
    if [ "$conflicts" -gt 0 ]; then
        echo "$conflicts conflict(s): resolve them in $dir (markers <<<<<<< / >>>>>>>), then agent-sync sync." >&2
        exit 1
    fi
    echo "Review with: git -C \"$REPO_DIR\" diff -- skills/$name   then: agent-sync sync"
}

do_skill() {
    shift
    local sub="${1:-list}"
    [ $# -gt 0 ] && shift
    case "$sub" in
        list)
            skill_list
            ;;
        add)
            [ $# -ge 2 ] || die "usage: agent-sync skill add <name> <source> [path] [ref]"
            skill_add "$@"
            ;;
        diff)
            [ $# -ge 1 ] || die "usage: agent-sync skill diff <name>"
            skill_diff "$1"
            ;;
        update)
            [ $# -ge 1 ] || die "usage: agent-sync skill update <name> [ref]"
            skill_update "$1" "${2:-}"
            ;;
        *)
            die "unknown skill command '$sub' (expected list, add, diff, or update)"
            ;;
    esac
}

print_usage() {
    cat <<'USAGE'
Usage: agent-sync [-p PREFIX] [-w WORKDIR] [-a AGENTS] <command>

Commands:
  init [dir]   initialize a data directory (interactive wizard if dir omitted —
               detects existing agent content and offers to import)
  sync         backend sync + link (default)
  push         push local data to the configured backend
  pull         pull backend data + link
  link         set up / refresh symlinks for every enabled agent
  agents       list known agents, their homes, and which assets they accept
  memory [dir] print the canonical project-memory index for a repository
  match        preview, apply, or set project mappings
               (--dry-run to preview, --auto to apply suggestions,
                LOCAL:CANONICAL for an explicit mapping)
  instructions install/remove/status the managed block in instructions.md
  env          install/remove/status/print managed shell env block
  skill        vendored skills: list | add <name> <source> [path] [ref] |
               diff <name> | update <name> [ref]
               (source = a git URL or npm:<package>; see README)
  unlink       remove data-directory-owned symlinks
  clean        remove broken project memory symlinks
  status       show data directory, backend, projects, link health, and changes
  help         show this message

Options:
  -p, --prefix PREFIX   device prefix (default: auto from $HOME)
  -w, --workdir DIR     work directory under $HOME (default: $AGENT_SYNC_WORKDIR)
  -a, --agents LIST     comma-separated agents to link (default: claude)

Agents:
  claude    ~/.claude    instructions settings keybindings skills mcp-servers projects
  tclaude   ~/.tclaude   instructions settings keybindings skills mcp-servers projects
  codex     ~/.codex     instructions skills

  Codex keeps its settings in config.toml. Its native memories are generated
  state, so curated project memory is exposed through `agent-sync memory`
  instead of being linked into that store.

Environment:
  AGENT_SYNC_DIR        path to your private data directory (required for
                        every command except `init` and `help`)
  AGENT_SYNC_AGENTS     comma-separated agents to link (default: claude)
  AGENT_SYNC_BACKEND    storage backend: git, s3, gcs, or local (default: git)
  AGENT_SYNC_STORAGE_URI
                        s3://bucket/prefix or gs://bucket/prefix for object
                        storage backends
  AGENT_SYNC_STORAGE_OBJECT
                        object name for s3/gcs archive
                        (default: agent-sync-data.tar.gz)
  AGENT_SYNC_WORKDIR    parent dir under $HOME to strip from canonical
                        project names (e.g. "develop" strips ~/develop/)
  AGENT_SYNC_REMOTE     git remote name for backend git (default: origin)

For backend git, the branch your data directory is currently on is used for
push/pull, so `main`, `master`, or any other branch works.
USAGE
}

# ---------- dispatch ----------

case "$ACTION" in
    init)
        do_init
        exit 0
        ;;
    help)
        print_usage
        exit 0
        ;;
esac

REPO_DIR="$(resolve_repo_dir)"

case "$ACTION" in
    link)
        do_link
        ;;
    match)
        do_match
        ;;
    agents)
        do_agents
        ;;
    memory)
        do_memory "$ARG1"
        ;;
    instructions)
        do_instructions "${ARG1:-status}"
        ;;
    env)
        do_env "${ARG1:-status}"
        ;;
    skill|skills)
        do_skill "${ARGS[@]}"
        ;;
    unlink|uninstall)
        do_unlink
        ;;
    push)
        cd "$REPO_DIR"
        migrate_local_memory
        backend_require
        if [ "$BACKEND" = "git" ]; then
            if git_commit_if_needed; then
                backend_push
                echo "Pushed."
            else
                echo "Nothing to push."
            fi
        else
            backend_push
            echo "Pushed."
        fi
        ;;
    pull)
        cd "$REPO_DIR"
        backend_require
        backend_pull
        do_link
        echo "Pulled."
        ;;
    sync)
        cd "$REPO_DIR"
        backend_require
        if [ "$BACKEND" = "git" ]; then
            migrate_local_memory
            git_commit_if_needed || true
            backend_pull
            backend_push
        else
            backend_pull
            migrate_local_memory
            backend_push
        fi
        do_link
        echo "Synced."
        ;;
    clean)
        echo "Cleaning broken symlinks ..."
        clean_projects
        echo "Done."
        ;;
    status)
        cd "$REPO_DIR"
        echo "Data:    $REPO_DIR"
        echo "Backend: $BACKEND"
        echo "Agents:  $AGENTS_ENABLED"
        echo "Prefix:  $PREFIX"
        [ -n "$WORKDIR" ] && echo "Workdir: ~/$WORKDIR"
        if [ "$BACKEND" = "git" ] && git remote get-url "$REMOTE" >/dev/null 2>&1; then
            echo "Remote:  $REMOTE ($(git remote get-url "$REMOTE"))"
            echo "Branch:  $(git_branch)"
        elif [ "$BACKEND" = "s3" ] || [ "$BACKEND" = "gcs" ]; then
            echo "Storage: $(storage_object_uri)"
        elif [ "$BACKEND" = "git" ]; then
            echo "Remote:  (none configured)"
        else
            echo "Storage: local only"
        fi
        echo ""

        echo "Projects:"
        for canonical_mem in "$REPO_DIR"/projects/*/memory; do
            [ ! -d "$canonical_mem" ] && continue
            proj="$(basename "$(dirname "$canonical_mem")")"
            echo "  $proj"
        done
        echo ""

        if [ -f "$REPO_DIR/.agent-sync-projects" ]; then
            echo "Project mappings:"
            while IFS= read -r line || [ -n "$line" ]; do
                case "$line" in
                    ""|\#*) continue ;;
                esac
                echo "  $line"
            done < "$REPO_DIR/.agent-sync-projects"
            echo ""
        fi

        if [ -d "$REPO_DIR/skills" ]; then
            skill_list=""
            for skill_dir in "$REPO_DIR"/skills/*/; do
                [ ! -d "$skill_dir" ] && continue
                skill_list="$skill_list  $(basename "$skill_dir")"$'\n'
            done
            if [ -n "$skill_list" ]; then
                echo "Skills:"
                printf '%s' "$skill_list"
                echo ""
            fi
        fi

        if [ -d "$REPO_DIR/mcp-servers" ]; then
            srv_list=""
            for srv_dir in "$REPO_DIR"/mcp-servers/*/; do
                [ ! -d "$srv_dir" ] && continue
                srv_list="$srv_list  $(basename "$srv_dir")"$'\n'
            done
            if [ -n "$srv_list" ]; then
                echo "MCP Servers:"
                printf '%s' "$srv_list"
                echo ""
            fi
        fi

        health_lines=""
        check_link() {
            local label="$1" target="$2" expect_prefix="$3"
            if [ ! -e "$target" ] && [ ! -L "$target" ]; then
                health_lines="${health_lines}  missing      $label"$'\n'
            elif [ ! -L "$target" ]; then
                health_lines="${health_lines}  not-symlink  $label"$'\n'
            elif [ ! -e "$target" ]; then
                health_lines="${health_lines}  broken       $label"$'\n'
            else
                local dest
                dest="$(readlink "$target")"
                if [[ "$dest" == "$expect_prefix"* ]]; then
                    :
                else
                    health_lines="${health_lines}  foreign      $label -> $dest"$'\n'
                fi
            fi
        }
        while IFS= read -r agent; do
            set_agent_context "$agent"
            for asset in instructions settings keybindings; do
                rel="$(agent_asset "$agent" "$asset")"
                [ -n "$rel" ] || continue
                src="$(asset_source "$asset")"
                [ -e "$src" ] || continue
                check_link "$agent:$rel" "$AGENT_HOME/$rel" "$REPO_DIR/"
            done
            rel="$(agent_asset "$agent" projects)"
            [ -n "$rel" ] || continue
            for canonical_mem in "$REPO_DIR"/projects/*/memory; do
                [ ! -d "$canonical_mem" ] && continue
                canonical="$(basename "$(dirname "$canonical_mem")")"
                if [ "$canonical" = "_home" ]; then
                    device_name="$PREFIX"
                else
                    device_name="${PREFIX}${canonical}"
                fi
                check_link "$agent:projects/$canonical" \
                    "$AGENT_HOME/$rel/$device_name/memory" "$REPO_DIR/"
            done
        done < <(enabled_agents)
        if [ -n "$health_lines" ]; then
            echo "Link health:"
            printf '%s' "$health_lines"
            echo "  (run \`agent-sync link\` to repair)"
            echo ""
        fi

        if [ "$BACKEND" = "git" ] && [ -d "$REPO_DIR/.git" ]; then
            changes="$(git status --short)"
        else
            changes=""
        fi
        if [ -n "$changes" ]; then
            echo "Changes:"
            shown_projects=""
            other_lines=""
            while IFS= read -r line; do
                file="${line:3}"
                matched=false
                for canonical_mem in "$REPO_DIR"/projects/*/memory; do
                    [ ! -d "$canonical_mem" ] && continue
                    proj="$(basename "$(dirname "$canonical_mem")")"
                    if [[ "$file" == projects/"$proj"/* ]]; then
                        if [[ " $shown_projects " != *" $proj "* ]]; then
                            echo "  [$proj]"
                            shown_projects="$shown_projects $proj"
                        fi
                        echo "    ${line:0:2} ${file#projects/"$proj"/}"
                        matched=true
                        break
                    fi
                done
                if [ "$matched" = false ]; then
                    other_lines="${other_lines}${line}"$'\n'
                fi
            done <<< "$changes"
            if [ -n "$other_lines" ]; then
                echo "  [config]"
                while IFS= read -r line; do
                    [ -z "$line" ] && continue
                    echo "    $line"
                done <<< "$other_lines"
            fi
        elif [ "$BACKEND" = "git" ]; then
            echo "No changes."
        fi
        ;;
    *)
        print_usage
        exit 1
        ;;
esac
