#!/usr/bin/env bash
# claude-sync — sync Claude Code config and project memory across devices.
#
# Tool and data are decoupled:
#   • This script is the tool. Install it once per machine.
#   • Your config lives in a private local data directory.
#     Point CLAUDE_SYNC_DIR at it, then choose a sync backend.
#
# https://github.com/lizhizhi7/claude-sync

set -euo pipefail

CLAUDE_DIR="$HOME/.claude"
REMOTE="${CLAUDE_SYNC_REMOTE:-origin}"
BACKEND="${CLAUDE_SYNC_BACKEND:-git}"
STORAGE_URI="${CLAUDE_SYNC_STORAGE_URI:-}"
STORAGE_OBJECT="${CLAUDE_SYNC_STORAGE_OBJECT:-claude-sync-data.tar.gz}"
BACKUP_STAMP="$(date '+%Y%m%d-%H%M%S')"
BACKUP_DIR="$CLAUDE_DIR/backups/claude-sync-$BACKUP_STAMP"
ENV_BLOCK_START="# >>> claude-sync >>>"
ENV_BLOCK_END="# <<< claude-sync <<<"
AGENT_BLOCK_START="<!-- >>> claude-sync:auto-sync >>> -->"
AGENT_BLOCK_END="<!-- <<< claude-sync:auto-sync <<< -->"

die() {
    echo "ERROR: $*" >&2
    exit 1
}

# ---------- arg parsing ----------

PREFIX=""
WORKDIR=""
WORKDIR_SET=false
ARGS=()
UNLINK_ENV=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--prefix)
            [ $# -ge 2 ] || die "$1 requires a value"
            PREFIX="$2"
            shift 2
            ;;
        -w|--workdir)
            [ $# -ge 2 ] || die "$1 requires a value"
            WORKDIR="$2"
            WORKDIR_SET=true
            shift 2
            ;;
        -h|--help)    ARGS+=("help"); shift ;;
        --env)        UNLINK_ENV=true; shift ;;
        *)            ARGS+=("$1"); shift ;;
    esac
done
ACTION="${ARGS[0]:-sync}"
ARG1="${ARGS[1]:-}"

[ "$WORKDIR_SET" = false ] && [ -n "${CLAUDE_SYNC_WORKDIR:-}" ] && WORKDIR="$CLAUDE_SYNC_WORKDIR"
[ -z "$PREFIX" ] && PREFIX="$(echo "$HOME" | tr '/' '-')"
[ -n "$WORKDIR" ] && PREFIX="${PREFIX}-$(echo "$WORKDIR" | tr '/' '-')"

# ---------- data directory resolution ----------

resolve_repo_dir() {
    if [ -z "${CLAUDE_SYNC_DIR:-}" ]; then
        echo "ERROR: CLAUDE_SYNC_DIR is not set." >&2
        echo "" >&2
        echo "  Point it at your private data directory:" >&2
        echo "    export CLAUDE_SYNC_DIR=\"\$HOME/path/to/your/config\"" >&2
        echo "" >&2
        echo "  Or initialize a new one:" >&2
        echo "    claude-sync init ~/path/to/your/config" >&2
        exit 1
    fi
    if [ ! -d "$CLAUDE_SYNC_DIR" ]; then
        echo "ERROR: CLAUDE_SYNC_DIR=$CLAUDE_SYNC_DIR does not exist." >&2
        exit 1
    fi
    local dir
    dir="$(cd "$CLAUDE_SYNC_DIR" && pwd -P)"
    if [ "$dir" = "$CLAUDE_DIR" ] || [[ "$dir" == "$CLAUDE_DIR"/* ]]; then
        echo "ERROR: CLAUDE_SYNC_DIR must not be inside $CLAUDE_DIR." >&2
        exit 1
    fi
    if [ ! -e "$dir/.claude-sync-data" ]; then
        echo "ERROR: $dir is not marked as a claude-sync data directory." >&2
        echo "  Run: claude-sync init \"$dir\"" >&2
        echo "  Or, if you know this directory is safe: touch \"$dir/.claude-sync-data\"" >&2
        exit 1
    fi
    printf '%s\n' "$dir"
}

# ---------- helpers ----------

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

is_repo_target() {
    local dest="$1"
    case "$dest" in
        "$REPO_DIR"|"$REPO_DIR"/*) return 0 ;;
        *) return 1 ;;
    esac
}

backup_path() {
    local path="$1" rel dest
    [ -e "$path" ] || [ -L "$path" ] || return 0
    rel="${path#"$CLAUDE_DIR"/}"
    dest="$BACKUP_DIR/$rel"
    mkdir -p "$(dirname "$dest")"
    mv "$path" "$dest"
    echo "  backed up existing $rel -> $dest"
}

make_link() {
    local target="$1" link_path="$2"
    local link_dir link_name
    link_dir="$(dirname "$link_path")"
    link_name="$(basename "$link_path")"
    mkdir -p "$link_dir"
    if [ -L "$link_path" ]; then
        rm -f "$link_path"
    elif [ -e "$link_path" ]; then
        backup_path "$link_path"
    fi
    ( cd "$link_dir" && ln -s -- "$target" "$link_name" )
}

copy_tree_no_clobber() {
    local src="$1" dst="$2"
    mkdir -p "$dst"
    cp -pRn "$src/." "$dst/" 2>/dev/null || true
}

shell_quote() {
    printf '%q' "$1"
}

remove_managed_block() {
    local file="$1" start="$2" end="$3" tmp
    [ -f "$file" ] || return 0
    tmp="$(mktemp)"
    awk -v start="$start" -v end="$end" '
        $0 == start { skip = 1; next }
        $0 == end { skip = 0; next }
        skip != 1 { print }
    ' "$file" > "$tmp"
    mv "$tmp" "$file"
}

write_managed_block() {
    local file="$1" start="$2" end="$3" body="$4" need_blank=false
    mkdir -p "$(dirname "$file")"
    [ -f "$file" ] || touch "$file"
    remove_managed_block "$file" "$start" "$end"
    [ -s "$file" ] && need_blank=true
    {
        [ "$need_blank" = true ] && printf '\n'
        printf '%s\n' "$start"
        printf '%s\n' "$body"
        printf '%s\n' "$end"
    } >> "$file"
}

managed_block_present() {
    local file="$1" start="$2"
    [ -f "$file" ] && grep -Fqx "$start" "$file"
}

default_shell_profile() {
    case "$(basename "${SHELL:-}")" in
        zsh) printf '%s\n' "$HOME/.zshrc" ;;
        bash) printf '%s\n' "$HOME/.bashrc" ;;
        *) printf '%s\n' "$HOME/.profile" ;;
    esac
}

env_profiles() {
    printf '%s\n' "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile"
}

git_branch() {
    git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null
}

require_remote() {
    if ! git -C "$REPO_DIR" remote get-url "$REMOTE" >/dev/null 2>&1; then
        echo "ERROR: git remote '$REMOTE' not configured in $REPO_DIR." >&2
        echo "  Add one with:" >&2
        echo "    git -C \"$REPO_DIR\" remote add $REMOTE git@github.com:USER/REPO.git" >&2
        exit 1
    fi
}

git_pull_rebase() {
    local branch
    branch="$(git_branch)"
    if ! git -C "$REPO_DIR" ls-remote --exit-code --heads "$REMOTE" "$branch" >/dev/null 2>&1; then
        echo "Remote branch '$branch' not on '$REMOTE' yet; skipping pull."
        return 0
    fi
    if ! git -C "$REPO_DIR" pull --rebase "$REMOTE" "$branch"; then
        echo "" >&2
        echo "ERROR: rebase failed in $REPO_DIR." >&2
        echo "  resolve conflicts then run: git -C \"$REPO_DIR\" rebase --continue" >&2
        echo "  or to abandon:              git -C \"$REPO_DIR\" rebase --abort" >&2
        exit 1
    fi
}

storage_object_uri() {
    [ -n "$STORAGE_URI" ] || die "CLAUDE_SYNC_STORAGE_URI is required for backend '$BACKEND'."
    printf '%s/%s\n' "${STORAGE_URI%/}" "$STORAGE_OBJECT"
}

create_storage_archive() {
    local archive="$1" stage path
    stage="$(mktemp -d)"
    for path in .gitignore .claude-sync-data .claude-sync-projects README.md settings.json CLAUDE.md keybindings.json skills mcp-servers projects; do
        [ -e "$REPO_DIR/$path" ] || continue
        cp -pR "$REPO_DIR/$path" "$stage/$path"
    done
    if [ -d "$stage/mcp-servers" ]; then
        find "$stage/mcp-servers" -path '*/.venv' -type d -prune -exec rm -rf {} +
    fi
    if [ -d "$stage/projects" ]; then
        find "$stage/projects" -name '*.jsonl' -type f -delete
    fi
    tar -czf "$archive" -C "$stage" .
    rm -rf "$stage"
}

validate_storage_archive() {
    local archive="$1" path line
    while IFS= read -r path; do
        case "$path" in
            /*|../*|*/../*|*/..)
                die "refusing to extract unsafe archive path: $path"
                ;;
        esac
    done < <(tar -tzf "$archive")
    # Reject symlink and hardlink members BEFORE extraction: extracting a
    # symlink and then a member whose path passes through it writes outside
    # the extraction directory.
    while IFS= read -r line; do
        case "$line" in
            l*) die "refusing to extract archive containing symlink: $line" ;;
            h*) die "refusing to extract archive containing hardlink: $line" ;;
        esac
    done < <(tar -tvzf "$archive")
}

extract_storage_archive() {
    local archive="$1" extract_dir="$2" first_link
    mkdir -p "$extract_dir"
    validate_storage_archive "$archive"
    tar -xzf "$archive" -C "$extract_dir"
    first_link="$(find "$extract_dir" -type l -print -quit)"
    [ -z "$first_link" ] || die "refusing to extract archive containing symlink: $first_link"
}

clear_synced_data_paths() {
    local path
    for path in \
        "$REPO_DIR/settings.json" \
        "$REPO_DIR/keybindings.json" \
        "$REPO_DIR/CLAUDE.md" \
        "$REPO_DIR/.claude-sync-projects" \
        "$REPO_DIR/skills" \
        "$REPO_DIR/mcp-servers" \
        "$REPO_DIR/projects"; do
        [ -e "$path" ] || [ -L "$path" ] || continue
        rm -rf "$path"
    done
}

backend_require() {
    local top branch
    case "$BACKEND" in
        git)
            command_exists git || die "git is required for backend 'git'."
            top="$(git -C "$REPO_DIR" rev-parse --show-toplevel 2>/dev/null)" \
                || die "backend 'git': $REPO_DIR is not a git repository. Run: git -C \"$REPO_DIR\" init"
            [ "$top" = "$REPO_DIR" ] \
                || die "backend 'git': $REPO_DIR is inside another git repository ($top). Initialize it as its own repository first."
            branch="$(git_branch)"
            [ "$branch" != "HEAD" ] \
                || die "backend 'git': $REPO_DIR is on a detached HEAD; check out a branch first."
            require_remote
            ;;
        s3)
            command_exists aws || die "AWS CLI is required for backend 's3'."
            case "$(storage_object_uri)" in
                s3://*) : ;;
                *) die "CLAUDE_SYNC_STORAGE_URI must start with s3:// for backend 's3'." ;;
            esac
            ;;
        gcs)
            command_exists gcloud || die "gcloud CLI is required for backend 'gcs'."
            case "$(storage_object_uri)" in
                gs://*) : ;;
                *) die "CLAUDE_SYNC_STORAGE_URI must start with gs:// for backend 'gcs'." ;;
            esac
            ;;
        local)
            ;;
        *)
            die "unknown CLAUDE_SYNC_BACKEND '$BACKEND' (expected git, s3, gcs, or local)."
            ;;
    esac
}

backend_pull() {
    local uri tmp
    case "$BACKEND" in
        git)
            git_pull_rebase
            ;;
        s3)
            uri="$(storage_object_uri)"
            tmp="$(mktemp -d)"
            if aws s3 ls "$uri" >/dev/null 2>&1; then
                aws s3 cp "$uri" "$tmp/data.tar.gz"
                extract_storage_archive "$tmp/data.tar.gz" "$tmp/extract"
                clear_synced_data_paths
                cp -pR "$tmp/extract/." "$REPO_DIR/"
                echo "Pulled archive from $uri."
            else
                echo "No remote archive found at $uri."
            fi
            rm -rf "$tmp"
            ;;
        gcs)
            uri="$(storage_object_uri)"
            tmp="$(mktemp -d)"
            if gcloud storage ls "$uri" >/dev/null 2>&1; then
                gcloud storage cp "$uri" "$tmp/data.tar.gz"
                extract_storage_archive "$tmp/data.tar.gz" "$tmp/extract"
                clear_synced_data_paths
                cp -pR "$tmp/extract/." "$REPO_DIR/"
                echo "Pulled archive from $uri."
            else
                echo "No remote archive found at $uri."
            fi
            rm -rf "$tmp"
            ;;
        local)
            echo "Local backend: nothing to pull."
            ;;
    esac
}

backend_push() {
    local uri tmp
    case "$BACKEND" in
        git)
            git push "$REMOTE" "$(git_branch)"
            ;;
        s3)
            uri="$(storage_object_uri)"
            tmp="$(mktemp -d)"
            create_storage_archive "$tmp/data.tar.gz"
            aws s3 cp "$tmp/data.tar.gz" "$uri"
            rm -rf "$tmp"
            echo "Pushed archive to $uri."
            ;;
        gcs)
            uri="$(storage_object_uri)"
            tmp="$(mktemp -d)"
            create_storage_archive "$tmp/data.tar.gz"
            gcloud storage cp "$tmp/data.tar.gz" "$uri"
            rm -rf "$tmp"
            echo "Pushed archive to $uri."
            ;;
        local)
            echo "Local backend: nothing to push."
            ;;
    esac
}

git_commit_if_needed() {
    git add -A
    if git diff --cached --quiet; then
        return 1
    fi
    git commit -m "sync: $(hostname 2>/dev/null || uname -n) $(date '+%Y-%m-%d %H:%M')"
}

# ---------- linking ----------

validate_project_name() {
    local name="$1"
    [ -n "$name" ] || die "empty project name"
    case "$name" in
        .|..|*/*|*$'\n'*)
            die "invalid project name '$name'"
            ;;
    esac
}

canonical_for_device_project() {
    local device_name="$1" mapped
    mapped="$(project_mapping_lookup "$device_name")"
    if [ -n "$mapped" ]; then
        printf '%s\n' "$mapped"
    elif [ "$device_name" = "$PREFIX" ]; then
        printf '%s\n' "_home"
    elif [[ "$device_name" == "$PREFIX"-* ]]; then
        printf '%s\n' "${device_name#"$PREFIX"}"
    elif [[ "$device_name" == "$PREFIX"* ]]; then
        printf '%s\n' "${device_name#"$PREFIX"}"
    else
        printf '%s\n' "$device_name"
    fi
}

project_mapping_lookup() {
    local local_name="$1" map_file line lhs rhs
    map_file="$REPO_DIR/.claude-sync-projects"
    [ -f "$map_file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            ""|\#*) continue ;;
        esac
        lhs="${line%%[[:space:]]*}"
        rhs="${line#"$lhs"}"
        rhs="${rhs#"${rhs%%[![:space:]]*}"}"
        [ "$lhs" = "$local_name" ] || continue
        printf '%s\n' "$rhs"
        return 0
    done < "$map_file"
}

write_project_mapping() {
    local local_name="$1" canonical="$2" map_file tmp line lhs
    validate_project_name "$local_name"
    validate_project_name "$canonical"
    map_file="$REPO_DIR/.claude-sync-projects"
    tmp="$(mktemp)"
    if [ -f "$map_file" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ""|\#*) printf '%s\n' "$line" >> "$tmp"; continue ;;
            esac
            lhs="${line%%[[:space:]]*}"
            [ "$lhs" = "$local_name" ] && continue
            printf '%s\n' "$line" >> "$tmp"
        done < "$map_file"
    fi
    printf '%s %s\n' "$local_name" "$canonical" >> "$tmp"
    mv "$tmp" "$map_file"
}

apply_project_mapping() {
    local local_name="$1" canonical="$2" local_mem canonical_mem
    validate_project_name "$local_name"
    validate_project_name "$canonical"
    local_mem="$CLAUDE_DIR/projects/$local_name/memory"
    canonical_mem="$REPO_DIR/projects/$canonical/memory"
    mkdir -p "$canonical_mem"
    if [ -d "$local_mem" ] && [ ! -L "$local_mem" ]; then
        copy_tree_no_clobber "$local_mem" "$canonical_mem"
    fi
    write_project_mapping "$local_name" "$canonical"
    make_link "$canonical_mem" "$local_mem"
    echo "  mapped $local_name -> $canonical"
}

link_configs() {
    mkdir -p "$CLAUDE_DIR"
    local f
    for f in settings.json keybindings.json CLAUDE.md; do
        if [ -f "$REPO_DIR/$f" ]; then
            make_link "$REPO_DIR/$f" "$CLAUDE_DIR/$f"
            echo "  linked $f"
        fi
    done
    if [ -d "$REPO_DIR/skills" ]; then
        make_link "$REPO_DIR/skills" "$CLAUDE_DIR/skills"
        echo "  linked skills/"
    fi
    if [ -d "$REPO_DIR/mcp-servers" ]; then
        mkdir -p "$CLAUDE_DIR/mcp-servers"
        local srv_dir srv_name target inner inner_name dest
        for srv_dir in "$REPO_DIR"/mcp-servers/*/; do
            [ ! -d "$srv_dir" ] && continue
            srv_name="$(basename "$srv_dir")"
            target="$CLAUDE_DIR/mcp-servers/$srv_name"
            # A whole-directory symlink (from an older layout) would shadow
            # the per-file links; replace it with a real directory.
            if [ -L "$target" ]; then
                rm -f "$target"
            fi
            mkdir -p "$target"
            for inner in "$srv_dir"* "$srv_dir".[!.]* "$srv_dir"..?*; do
                [ -e "$inner" ] || [ -L "$inner" ] || continue
                inner_name="$(basename "$inner")"
                [ "$inner_name" = ".venv" ] && continue
                make_link "$inner" "$target/$inner_name"
            done
            # Prune stale links to files removed from the data directory,
            # leaving device-local entries (like .venv) alone.
            for inner in "$target"/* "$target"/.[!.]* "$target"/..?*; do
                [ -L "$inner" ] || continue
                dest="$(readlink "$inner")"
                if is_repo_target "$dest" && [ ! -e "$inner" ]; then
                    rm -f "$inner"
                fi
            done
            echo "  linked mcp-server: $srv_name"
        done
    fi
}

link_projects() {
    mkdir -p "$CLAUDE_DIR/projects"
    local count=0 canonical_mem canonical device_name map_file line local_name mapped
    map_file="$REPO_DIR/.claude-sync-projects"
    if [ -f "$map_file" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ""|\#*) continue ;;
            esac
            local_name="${line%%[[:space:]]*}"
            mapped="${line#"$local_name"}"
            mapped="${mapped#"${mapped%%[![:space:]]*}"}"
            [ -n "$mapped" ] || continue
            validate_project_name "$local_name"
            validate_project_name "$mapped"
            mkdir -p "$REPO_DIR/projects/$mapped/memory" "$CLAUDE_DIR/projects/$local_name"
            make_link "$REPO_DIR/projects/$mapped/memory" "$CLAUDE_DIR/projects/$local_name/memory"
            count=$((count + 1))
        done < "$map_file"
    fi
    for canonical_mem in "$REPO_DIR"/projects/*/memory; do
        [ ! -d "$canonical_mem" ] && continue
        canonical="$(basename "$(dirname "$canonical_mem")")"

        mkdir -p "$CLAUDE_DIR/projects/$canonical"
        make_link "$canonical_mem" "$CLAUDE_DIR/projects/$canonical/memory"

        if [ "$canonical" = "_home" ]; then
            device_name="$PREFIX"
        else
            device_name="${PREFIX}${canonical}"
        fi
        mkdir -p "$CLAUDE_DIR/projects/$device_name"
        make_link "$canonical_mem" "$CLAUDE_DIR/projects/$device_name/memory"

        count=$((count + 1))
    done
    [ "$count" -gt 0 ] && echo "  linked memory for $count project(s)"
    return 0
}

migrate_local_memory() {
    [ ! -d "$CLAUDE_DIR/projects" ] && return 0
    local count=0 device_mem device_dir canonical
    for device_mem in "$CLAUDE_DIR/projects/${PREFIX}"-*/memory; do
        [ ! -d "$device_mem" ] && continue
        [ -L "$device_mem" ] && continue
        device_dir="$(basename "$(dirname "$device_mem")")"
        canonical="$(canonical_for_device_project "$device_dir")"
        mkdir -p "$REPO_DIR/projects/$canonical/memory"
        copy_tree_no_clobber "$device_mem" "$REPO_DIR/projects/$canonical/memory"
        count=$((count + 1))
    done
    if [ -d "$CLAUDE_DIR/projects/$PREFIX/memory" ] \
       && [ ! -L "$CLAUDE_DIR/projects/$PREFIX/memory" ]; then
        mkdir -p "$REPO_DIR/projects/_home/memory"
        copy_tree_no_clobber "$CLAUDE_DIR/projects/$PREFIX/memory" "$REPO_DIR/projects/_home/memory"
        count=$((count + 1))
    fi
    [ "$count" -gt 0 ] && echo "  migrated memory from $count local project(s)"
    return 0
}

clean_projects() {
    [ ! -d "$CLAUDE_DIR/projects" ] && return 0
    local count=0 mem_link proj_dir
    for mem_link in "$CLAUDE_DIR"/projects/*/memory; do
        [ ! -L "$mem_link" ] && continue
        if [ ! -e "$mem_link" ]; then
            proj_dir="$(dirname "$mem_link")"
            rm -f "$mem_link"
            rmdir "$proj_dir" 2>/dev/null || true
            count=$((count + 1))
        fi
    done
    [ "$count" -gt 0 ] && echo "  cleaned $count broken symlink(s)"
    return 0
}

do_link() {
    echo "Linking $REPO_DIR (prefix: $PREFIX) ..."
    migrate_local_memory
    clean_projects
    link_configs
    link_projects
    echo "Done."
}

do_unlink() {
    echo "Unlinking claude-sync from $CLAUDE_DIR ..."
    local removed=0 dest f target srv_dir srv_name touched inner mem_link
    for f in settings.json keybindings.json CLAUDE.md skills; do
        target="$CLAUDE_DIR/$f"
        if [ -L "$target" ]; then
            dest="$(readlink "$target")"
            if is_repo_target "$dest"; then
                rm -f "$target"
                echo "  unlinked $f"
                removed=$((removed+1))
            fi
        fi
    done
    if [ -d "$CLAUDE_DIR/mcp-servers" ]; then
        for srv_dir in "$CLAUDE_DIR"/mcp-servers/*/; do
            [ ! -d "$srv_dir" ] && continue
            srv_name="$(basename "$srv_dir")"
            touched=false
            for inner in "$srv_dir"* "$srv_dir".[!.]* "$srv_dir"..?*; do
                [ ! -e "$inner" ] && [ ! -L "$inner" ] && continue
                if [ -L "$inner" ]; then
                    dest="$(readlink "$inner")"
                    if is_repo_target "$dest"; then
                        rm -f "$inner"
                        touched=true
                    fi
                fi
            done
            if [ -z "$(ls -A "$srv_dir" 2>/dev/null)" ]; then
                rmdir "$srv_dir" 2>/dev/null || true
            fi
            if [ "$touched" = true ]; then
                echo "  unlinked mcp-server: $srv_name"
                removed=$((removed+1))
            fi
        done
        rmdir "$CLAUDE_DIR/mcp-servers" 2>/dev/null || true
    fi
    if [ -d "$CLAUDE_DIR/projects" ]; then
        for mem_link in "$CLAUDE_DIR"/projects/*/memory; do
            [ ! -L "$mem_link" ] && continue
            dest="$(readlink "$mem_link")"
            if is_repo_target "$dest"; then
                rm -f "$mem_link"
                rmdir "$(dirname "$mem_link")" 2>/dev/null || true
                removed=$((removed+1))
            fi
        done
    fi
    if [ "$removed" -eq 0 ]; then
        echo "  nothing to unlink."
    else
        echo "Unlinked $removed item(s). Data directory at $REPO_DIR is intact."
    fi
    if [ "$UNLINK_ENV" = true ]; then
        do_env remove
    fi
}

env_block_body() {
    local body
    body="export CLAUDE_SYNC_DIR=$(shell_quote "$REPO_DIR")"
    body="${body}"$'\n'"export CLAUDE_SYNC_BACKEND=$(shell_quote "$BACKEND")"
    [ -n "$STORAGE_URI" ] && body="${body}"$'\n'"export CLAUDE_SYNC_STORAGE_URI=$(shell_quote "$STORAGE_URI")"
    [ -n "$STORAGE_OBJECT" ] && [ "$STORAGE_OBJECT" != "claude-sync-data.tar.gz" ] \
        && body="${body}"$'\n'"export CLAUDE_SYNC_STORAGE_OBJECT=$(shell_quote "$STORAGE_OBJECT")"
    [ -n "$WORKDIR" ] && body="${body}"$'\n'"export CLAUDE_SYNC_WORKDIR=$(shell_quote "$WORKDIR")"
    [ -n "$REMOTE" ] && [ "$REMOTE" != "origin" ] && body="${body}"$'\n'"export CLAUDE_SYNC_REMOTE=$(shell_quote "$REMOTE")"
    printf '%s\n' "$body"
}

do_env() {
    local sub="${1:-status}" profile found=false
    case "$sub" in
        install)
            profile="$(default_shell_profile)"
            write_managed_block "$profile" "$ENV_BLOCK_START" "$ENV_BLOCK_END" "$(env_block_body)"
            echo "Installed claude-sync env block in $profile"
            ;;
        remove|clean)
            while IFS= read -r profile; do
                if managed_block_present "$profile" "$ENV_BLOCK_START"; then
                    remove_managed_block "$profile" "$ENV_BLOCK_START" "$ENV_BLOCK_END"
                    echo "Removed claude-sync env block from $profile"
                    found=true
                fi
            done < <(env_profiles)
            [ "$found" = true ] || echo "No managed claude-sync env blocks found."
            ;;
        status)
            while IFS= read -r profile; do
                if managed_block_present "$profile" "$ENV_BLOCK_START"; then
                    echo "managed env block: $profile"
                    found=true
                fi
            done < <(env_profiles)
            [ "$found" = true ] || echo "No managed claude-sync env blocks found."
            ;;
        print)
            printf '%s\n' "$ENV_BLOCK_START"
            env_block_body
            printf '%s\n' "$ENV_BLOCK_END"
            ;;
        *)
            die "unknown env command '$sub' (expected install, remove, status, or print)"
            ;;
    esac
}

agent_instruction_body() {
    cat <<'EOF'
Use claude-sync for durable Claude Code configuration and memory changes on this machine:

- Run `claude-sync status` before changing synced config or project memory when context is unclear.
- Run `claude-sync match` if a project appears under a new local project name.
- Run `claude-sync sync` after changes that should be shared across devices.
- Do not edit shell profiles, unlink synced files, or delete local Claude data unless the user asks.
EOF
}

detect_agent_targets() {
    if command_exists claude || [ -d "$CLAUDE_DIR" ] || [ -f "$REPO_DIR/CLAUDE.md" ]; then
        printf '%s\t%s\n' "Claude Code" "$REPO_DIR/CLAUDE.md"
    fi
    if command_exists codex || [ -d "$HOME/.codex" ] || [ -f "$HOME/.codex/AGENTS.md" ]; then
        printf '%s\t%s\n' "Codex" "$HOME/.codex/AGENTS.md"
    fi
}

do_agents() {
    local sub="${1:-status}" found=false name target
    case "$sub" in
        install)
            while IFS=$'\t' read -r name target; do
                [ -n "$name" ] || continue
                write_managed_block "$target" "$AGENT_BLOCK_START" "$AGENT_BLOCK_END" "$(agent_instruction_body)"
                echo "Installed claude-sync agent instruction for $name: $target"
                found=true
            done < <(detect_agent_targets)
            [ "$found" = true ] || echo "No supported agent tools detected."
            ;;
        remove|clean)
            while IFS=$'\t' read -r name target; do
                [ -n "$name" ] || continue
                if managed_block_present "$target" "$AGENT_BLOCK_START"; then
                    remove_managed_block "$target" "$AGENT_BLOCK_START" "$AGENT_BLOCK_END"
                    echo "Removed claude-sync agent instruction for $name: $target"
                    found=true
                fi
            done < <(detect_agent_targets)
            [ "$found" = true ] || echo "No managed claude-sync agent instructions found."
            ;;
        status)
            while IFS=$'\t' read -r name target; do
                [ -n "$name" ] || continue
                if managed_block_present "$target" "$AGENT_BLOCK_START"; then
                    echo "$name: managed instruction installed at $target"
                else
                    echo "$name: detected, no managed instruction at $target"
                fi
                found=true
            done < <(detect_agent_targets)
            [ "$found" = true ] || echo "No supported agent tools detected."
            ;;
        *)
            die "unknown agents command '$sub' (expected install, remove, or status)"
            ;;
    esac
}

project_link_state() {
    local mem="$1" dest
    if [ -L "$mem" ]; then
        if [ ! -e "$mem" ]; then
            printf '%s\n' "broken"
        else
            dest="$(readlink "$mem")"
            if is_repo_target "$dest"; then
                printf '%s\n' "linked"
            else
                printf '%s\n' "foreign"
            fi
        fi
    elif [ -d "$mem" ]; then
        printf '%s\n' "local"
    else
        printf '%s\n' "missing"
    fi
}

print_project_match_row() {
    local local_name="$1" state="$2" canonical="$3"
    printf '  %-10s %-48s -> %s\n' "$state" "$local_name" "$canonical"
}

do_match() {
    local dry_run=false auto=false explicit=false arg local_name canonical
    local projects_dir="$CLAUDE_DIR/projects"
    local mem device_dir state suggestion applied=0 seen=0
    local i=1

    while [ "$i" -lt "${#ARGS[@]}" ]; do
        arg="${ARGS[$i]}"
        case "$arg" in
            --auto)
                auto=true
                ;;
            --dry-run)
                dry_run=true
                ;;
            *:*)
                local_name="${arg%%:*}"
                canonical="${arg#*:}"
                apply_project_mapping "$local_name" "$canonical"
                explicit=true
                applied=$((applied + 1))
                ;;
            *)
                die "unknown match argument '$arg'"
                ;;
        esac
        i=$((i + 1))
    done

    if [ "$explicit" = true ]; then
        echo "Applied $applied explicit mapping(s)."
        return 0
    fi
    if [ "$auto" = false ] && [ "$dry_run" = false ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
        dry_run=true
    fi

    echo "Project match scan"
    echo "Data:   $REPO_DIR"
    echo "Prefix: $PREFIX"
    echo ""

    if [ ! -d "$projects_dir" ]; then
        echo "No local Claude projects found."
        return 0
    fi

    for mem in "$projects_dir"/*/memory; do
        [ -e "$mem" ] || [ -L "$mem" ] || continue
        device_dir="$(basename "$(dirname "$mem")")"
        state="$(project_link_state "$mem")"
        suggestion="$(canonical_for_device_project "$device_dir")"
        seen=$((seen + 1))

        case "$state" in
            linked)
                print_project_match_row "$device_dir" "$state" "$suggestion"
                ;;
            local)
                print_project_match_row "$device_dir" "$state" "$suggestion"
                if [ "$dry_run" = true ]; then
                    :
                elif [ "$auto" = true ]; then
                    apply_project_mapping "$device_dir" "$suggestion"
                    applied=$((applied + 1))
                elif [ -t 0 ] && [ -t 1 ]; then
                    if prompt_yn "Map $device_dir to $suggestion?"; then
                        apply_project_mapping "$device_dir" "$suggestion"
                        applied=$((applied + 1))
                    fi
                fi
                ;;
            broken|foreign)
                print_project_match_row "$device_dir" "$state" "$suggestion"
                ;;
        esac
    done

    if [ "$seen" -eq 0 ]; then
        echo "No local Claude project memory directories found."
    elif [ "$dry_run" = true ]; then
        echo ""
        echo "Preview only. Use 'claude-sync match --auto' to apply suggestions,"
        echo "or 'claude-sync match LOCAL:CANONICAL' for an explicit mapping."
    elif [ "$applied" -gt 0 ]; then
        echo ""
        echo "Applied $applied project mapping(s)."
    fi
}

prompt_yn() {
    local q="$1" def="${2:-y}" hint reply
    [ "$def" = "y" ] && hint="[Y/n]" || hint="[y/N]"
    while :; do
        read -r -p "$q $hint " reply </dev/tty || return 1
        reply="${reply:-$def}"
        case "$reply" in
            [Yy]|[Yy][Ee][Ss]) return 0 ;;
            [Nn]|[Nn][Oo])     return 1 ;;
        esac
    done
}

prompt_path() {
    local q="$1" def="$2" reply
    if [ -n "$def" ]; then
        read -r -p "$q [$def]: " reply </dev/tty || return 1
        reply="${reply:-$def}"
    else
        read -r -p "$q: " reply </dev/tty || return 1
    fi
    # shellcheck disable=SC2088  # matching a literal leading tilde in user input
    case "$reply" in
        "~"|"~/"*) reply="$HOME${reply#\~}" ;;
    esac
    printf '%s' "$reply"
}

has_existing_claude_content() {
    [ -d "$CLAUDE_DIR" ] || return 1
    local f d
    for f in settings.json CLAUDE.md keybindings.json; do
        [ -f "$CLAUDE_DIR/$f" ] && [ ! -L "$CLAUDE_DIR/$f" ] && return 0
    done
    if [ -d "$CLAUDE_DIR/skills" ] && [ ! -L "$CLAUDE_DIR/skills" ]; then
        [ -n "$(ls -A "$CLAUDE_DIR/skills" 2>/dev/null)" ] && return 0
    fi
    if [ -d "$CLAUDE_DIR/mcp-servers" ] && [ ! -L "$CLAUDE_DIR/mcp-servers" ]; then
        [ -n "$(ls -A "$CLAUDE_DIR/mcp-servers" 2>/dev/null)" ] && return 0
    fi
    if [ -d "$CLAUDE_DIR/projects" ]; then
        for d in "$CLAUDE_DIR/projects"/*/; do
            [ -d "$d/memory" ] && [ ! -L "$d/memory" ] && return 0
        done
    fi
    return 1
}

summarize_claude_content() {
    [ -d "$CLAUDE_DIR" ] || return 0
    local f n d
    for f in settings.json CLAUDE.md keybindings.json; do
        if [ -f "$CLAUDE_DIR/$f" ] && [ ! -L "$CLAUDE_DIR/$f" ]; then
            echo "  $f ($(du -h "$CLAUDE_DIR/$f" 2>/dev/null | awk '{print $1}'))"
        fi
    done
    if [ -d "$CLAUDE_DIR/skills" ] && [ ! -L "$CLAUDE_DIR/skills" ]; then
        n=$(find "$CLAUDE_DIR/skills" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
        [ "$n" -gt 0 ] && echo "  skills/ ($n skill(s))"
    fi
    if [ -d "$CLAUDE_DIR/mcp-servers" ] && [ ! -L "$CLAUDE_DIR/mcp-servers" ]; then
        n=$(find "$CLAUDE_DIR/mcp-servers" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
        [ "$n" -gt 0 ] && echo "  mcp-servers/ ($n server(s))"
    fi
    if [ -d "$CLAUDE_DIR/projects" ]; then
        n=0
        for d in "$CLAUDE_DIR/projects"/*/; do
            [ -d "$d/memory" ] && [ ! -L "$d/memory" ] && n=$((n+1))
        done
        [ "$n" -gt 0 ] && echo "  projects/ ($n project(s) with memory)"
    fi
}

import_existing_top_level() {
    local target="$1"
    local f srv_dir srv_name
    for f in settings.json CLAUDE.md keybindings.json; do
        if [ -f "$CLAUDE_DIR/$f" ] && [ ! -L "$CLAUDE_DIR/$f" ]; then
            cp -p "$CLAUDE_DIR/$f" "$target/$f"
            echo "  imported $f"
        fi
    done
    if [ -d "$CLAUDE_DIR/skills" ] && [ ! -L "$CLAUDE_DIR/skills" ] \
       && [ -n "$(ls -A "$CLAUDE_DIR/skills" 2>/dev/null)" ]; then
        mkdir -p "$target/skills"
        cp -R "$CLAUDE_DIR/skills/." "$target/skills/"
        echo "  imported skills/"
    fi
    if [ -d "$CLAUDE_DIR/mcp-servers" ] && [ ! -L "$CLAUDE_DIR/mcp-servers" ]; then
        local any=false
        for srv_dir in "$CLAUDE_DIR/mcp-servers"/*/; do
            [ ! -d "$srv_dir" ] && continue
            srv_name="$(basename "$srv_dir")"
            mkdir -p "$target/mcp-servers/$srv_name"
            cp -R "$srv_dir/." "$target/mcp-servers/$srv_name/"
            rm -rf "$target/mcp-servers/$srv_name/.venv"
            any=true
        done
        [ "$any" = true ] && echo "  imported mcp-servers/"
    fi
    return 0
}

write_data_repo_scaffold() {
    local target="$1"
    if [ "$BACKEND" = "git" ] && [ ! -d "$target/.git" ]; then
        git -C "$target" init -q -b main 2>/dev/null || git -C "$target" init -q
    fi
    cat > "$target/.gitignore" <<'EOF'
# claude-sync data directory — allowlist style.
# Ignore everything by default, then re-enable what should sync.
*

!.gitignore
!.claude-sync-data
!.claude-sync-projects
!README.md

# Top-level config
!settings.json
!CLAUDE.md
!keybindings.json

# Custom skills
!skills/
!skills/**

# Custom MCP servers (code only — keep .venv device-local)
!mcp-servers/
!mcp-servers/*/
!mcp-servers/**
mcp-servers/*/.venv/

# Project memory
!projects/
!projects/*/
!projects/*/memory/
!projects/*/memory/**

# Ignore conversation logs and other ephemera
projects/*/*.jsonl
EOF
    touch "$target/.claude-sync-data"
}

print_init_next_steps() {
    local target="$1" include_remote="${2:-true}"
    echo ""
    echo "Next steps:"
    echo "  1. Install the managed shell env block:"
    printf '       '
    [ "$BACKEND" != "git" ] && printf 'CLAUDE_SYNC_BACKEND="%s" ' "$BACKEND"
    [ -n "$STORAGE_URI" ] && printf 'CLAUDE_SYNC_STORAGE_URI="%s" ' "$STORAGE_URI"
    [ -n "$WORKDIR" ] && printf 'CLAUDE_SYNC_WORKDIR="%s" ' "$WORKDIR"
    printf 'CLAUDE_SYNC_DIR="%s" claude-sync env install\n' "$target"
    echo "     Or add manually to your shell profile:"
    echo "       export CLAUDE_SYNC_DIR=\"$target\""
    [ "$BACKEND" != "git" ] && echo "       export CLAUDE_SYNC_BACKEND=\"$BACKEND\""
    [ -n "$STORAGE_URI" ] && echo "       export CLAUDE_SYNC_STORAGE_URI=\"$STORAGE_URI\""
    [ -n "$WORKDIR" ] && echo "       export CLAUDE_SYNC_WORKDIR=\"$WORKDIR\""
    if [ "$BACKEND" = "git" ] && [ "$include_remote" = true ]; then
        echo "  2. Add a private remote (recommended):"
        echo "       git -C \"$target\" remote add origin git@github.com:USER/REPO.git"
        echo "  3. Set up symlinks:"
        echo "       CLAUDE_SYNC_DIR=\"$target\" claude-sync link"
    else
        echo "  2. Set up symlinks:"
        echo "       CLAUDE_SYNC_DIR=\"$target\" claude-sync link"
    fi
}

do_init_create() {
    # $1 = target, $2 = "import" (true|false)
    local target="$1" import="$2"
    if [ -e "$target" ] && [ -n "$(ls -A "$target" 2>/dev/null)" ]; then
        echo "ERROR: $target is not empty." >&2
        exit 1
    fi
    mkdir -p "$target"
    target="$(cd "$target" && pwd)"
    write_data_repo_scaffold "$target"

    if [ "$import" = true ]; then
        echo ""
        echo "Importing from $CLAUDE_DIR ..."
        import_existing_top_level "$target"
        REPO_DIR="$target"
        migrate_local_memory
        echo "Created $target with existing config imported."
    else
        echo "Initialized empty claude-sync data directory at $target"
    fi
    print_init_next_steps "$target" true
}

do_init() {
    local target="$ARG1"

    # Non-interactive: explicit target arg → empty repo, no import
    if [ -n "$target" ]; then
        do_init_create "$target" false
        return 0
    fi

    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "Usage: claude-sync init <directory>" >&2
        echo "  (or run in a TTY for interactive mode)" >&2
        exit 1
    fi

    # Interactive wizard
    local import=false use_existing=false

    if has_existing_claude_content; then
        echo "Found existing Claude Code data in $CLAUDE_DIR:"
        summarize_claude_content
        echo
        if prompt_yn "Make this a syncable data directory (all files including project memory)?"; then
            import=true
        fi
        echo
    fi

    if [ "$import" = false ]; then
        if prompt_yn "Do you already have a claude-sync data directory on disk?" n; then
            use_existing=true
        fi
        echo
    fi

    if [ "$use_existing" = true ]; then
        target="$(prompt_path "Data directory path" "")"
        if [ -z "$target" ] || [ ! -d "$target" ]; then
            echo "ERROR: $target does not exist." >&2
            exit 1
        fi
        target="$(cd "$target" && pwd)"
        echo "Using existing data directory at $target."
        print_init_next_steps "$target" false
        return 0
    fi

    target="$(prompt_path "Data directory path" "$HOME/.claude-config-data")"
    do_init_create "$target" "$import"
}

print_usage() {
    cat <<'USAGE'
Usage: claude-sync [-p PREFIX] [-w WORKDIR] <command>

Commands:
  init [dir]   initialize a data directory (interactive wizard if dir omitted —
               detects existing ~/.claude/ content and offers to import)
  sync         backend sync + link (default)
  push         push local data to the configured backend
  pull         pull backend data + link
  link         set up / refresh symlinks
  match        preview, apply, or set project mappings
               (--dry-run to preview, --auto to apply suggestions,
                LOCAL:CANONICAL for an explicit mapping)
  agents       install/remove/status managed agent instructions
  env          install/remove/status/print managed shell env block
  unlink       remove data-directory-owned symlinks
  clean        remove broken symlinks from ~/.claude/projects
  status       show data directory, backend, projects, link health, and changes
  help         show this message

Options:
  -p, --prefix PREFIX   device prefix (default: auto from $HOME)
  -w, --workdir DIR     work directory under $HOME (default: $CLAUDE_SYNC_WORKDIR)

Environment:
  CLAUDE_SYNC_DIR       path to your private data directory (required for
                        every command except `init` and `help`)
  CLAUDE_SYNC_BACKEND   storage backend: git, s3, gcs, or local (default: git)
  CLAUDE_SYNC_STORAGE_URI
                        s3://bucket/prefix or gs://bucket/prefix for object
                        storage backends
  CLAUDE_SYNC_STORAGE_OBJECT
                        object name for s3/gcs archive
                        (default: claude-sync-data.tar.gz)
  CLAUDE_SYNC_WORKDIR   parent dir under $HOME to strip from canonical
                        project names (e.g. "develop" strips ~/develop/)
  CLAUDE_SYNC_REMOTE    git remote name for backend git (default: origin)

For backend git, the branch your data directory is currently on is used for
push/pull, so `main`, `master`, or any other branch works.
USAGE
}

# ---------- dispatch ----------

case "$ACTION" in
    init)
        do_init
        exit 0
        ;;
    help)
        print_usage
        exit 0
        ;;
esac

REPO_DIR="$(resolve_repo_dir)"

case "$ACTION" in
    link)
        do_link
        ;;
    match)
        do_match
        ;;
    agents)
        do_agents "${ARG1:-status}"
        ;;
    env)
        do_env "${ARG1:-status}"
        ;;
    unlink|uninstall)
        do_unlink
        ;;
    push)
        cd "$REPO_DIR"
        migrate_local_memory
        backend_require
        if [ "$BACKEND" = "git" ]; then
            if git_commit_if_needed; then
                backend_push
                echo "Pushed."
            else
                echo "Nothing to push."
            fi
        else
            backend_push
            echo "Pushed."
        fi
        ;;
    pull)
        cd "$REPO_DIR"
        backend_require
        backend_pull
        do_link
        echo "Pulled."
        ;;
    sync)
        cd "$REPO_DIR"
        backend_require
        if [ "$BACKEND" = "git" ]; then
            migrate_local_memory
            git_commit_if_needed || true
            backend_pull
            backend_push
        else
            backend_pull
            migrate_local_memory
            backend_push
        fi
        do_link
        echo "Synced."
        ;;
    clean)
        echo "Cleaning broken symlinks ..."
        clean_projects
        echo "Done."
        ;;
    status)
        cd "$REPO_DIR"
        echo "Data:    $REPO_DIR"
        echo "Backend: $BACKEND"
        echo "Prefix:  $PREFIX"
        [ -n "$WORKDIR" ] && echo "Workdir: ~/$WORKDIR"
        if [ "$BACKEND" = "git" ] && git remote get-url "$REMOTE" >/dev/null 2>&1; then
            echo "Remote:  $REMOTE ($(git remote get-url "$REMOTE"))"
            echo "Branch:  $(git_branch)"
        elif [ "$BACKEND" = "s3" ] || [ "$BACKEND" = "gcs" ]; then
            echo "Storage: $(storage_object_uri)"
        elif [ "$BACKEND" = "git" ]; then
            echo "Remote:  (none configured)"
        else
            echo "Storage: local only"
        fi
        echo ""

        echo "Projects:"
        for canonical_mem in "$REPO_DIR"/projects/*/memory; do
            [ ! -d "$canonical_mem" ] && continue
            proj="$(basename "$(dirname "$canonical_mem")")"
            echo "  $proj"
        done
        echo ""

        if [ -f "$REPO_DIR/.claude-sync-projects" ]; then
            echo "Project mappings:"
            while IFS= read -r line || [ -n "$line" ]; do
                case "$line" in
                    ""|\#*) continue ;;
                esac
                echo "  $line"
            done < "$REPO_DIR/.claude-sync-projects"
            echo ""
        fi

        if [ -d "$REPO_DIR/skills" ]; then
            skill_list=""
            for skill_dir in "$REPO_DIR"/skills/*/; do
                [ ! -d "$skill_dir" ] && continue
                skill_list="$skill_list  $(basename "$skill_dir")"$'\n'
            done
            if [ -n "$skill_list" ]; then
                echo "Skills:"
                printf '%s' "$skill_list"
                echo ""
            fi
        fi

        if [ -d "$REPO_DIR/mcp-servers" ]; then
            srv_list=""
            for srv_dir in "$REPO_DIR"/mcp-servers/*/; do
                [ ! -d "$srv_dir" ] && continue
                srv_list="$srv_list  $(basename "$srv_dir")"$'\n'
            done
            if [ -n "$srv_list" ]; then
                echo "MCP Servers:"
                printf '%s' "$srv_list"
                echo ""
            fi
        fi

        health_lines=""
        check_link() {
            local label="$1" target="$2" expect_prefix="$3"
            if [ ! -e "$target" ] && [ ! -L "$target" ]; then
                health_lines="${health_lines}  missing      $label"$'\n'
            elif [ ! -L "$target" ]; then
                health_lines="${health_lines}  not-symlink  $label"$'\n'
            elif [ ! -e "$target" ]; then
                health_lines="${health_lines}  broken       $label"$'\n'
            else
                local dest
                dest="$(readlink "$target")"
                if [[ "$dest" == "$expect_prefix"* ]]; then
                    :
                else
                    health_lines="${health_lines}  foreign      $label -> $dest"$'\n'
                fi
            fi
        }
        for f in settings.json keybindings.json CLAUDE.md; do
            [ -f "$REPO_DIR/$f" ] && check_link "$f" "$CLAUDE_DIR/$f" "$REPO_DIR/"
        done
        [ -d "$REPO_DIR/skills" ] && check_link "skills" "$CLAUDE_DIR/skills" "$REPO_DIR/"
        for canonical_mem in "$REPO_DIR"/projects/*/memory; do
            [ ! -d "$canonical_mem" ] && continue
            canonical="$(basename "$(dirname "$canonical_mem")")"
            if [ "$canonical" = "_home" ]; then
                device_name="$PREFIX"
            else
                device_name="${PREFIX}${canonical}"
            fi
            check_link "projects/$canonical" "$CLAUDE_DIR/projects/$device_name/memory" "$REPO_DIR/"
        done
        if [ -n "$health_lines" ]; then
            echo "Link health:"
            printf '%s' "$health_lines"
            echo "  (run \`claude-sync link\` to repair)"
            echo ""
        fi

        if [ "$BACKEND" = "git" ] && [ -d "$REPO_DIR/.git" ]; then
            changes="$(git status --short)"
        else
            changes=""
        fi
        if [ -n "$changes" ]; then
            echo "Changes:"
            shown_projects=""
            other_lines=""
            while IFS= read -r line; do
                file="${line:3}"
                matched=false
                for canonical_mem in "$REPO_DIR"/projects/*/memory; do
                    [ ! -d "$canonical_mem" ] && continue
                    proj="$(basename "$(dirname "$canonical_mem")")"
                    if [[ "$file" == projects/"$proj"/* ]]; then
                        if [[ " $shown_projects " != *" $proj "* ]]; then
                            echo "  [$proj]"
                            shown_projects="$shown_projects $proj"
                        fi
                        echo "    ${line:0:2} ${file#projects/"$proj"/}"
                        matched=true
                        break
                    fi
                done
                if [ "$matched" = false ]; then
                    other_lines="${other_lines}${line}"$'\n'
                fi
            done <<< "$changes"
            if [ -n "$other_lines" ]; then
                echo "  [config]"
                while IFS= read -r line; do
                    [ -z "$line" ] && continue
                    echo "    $line"
                done <<< "$other_lines"
            fi
        elif [ "$BACKEND" = "git" ]; then
            echo "No changes."
        fi
        ;;
    *)
        print_usage
        exit 1
        ;;
esac
